)
# Drop completely empty rows
out %>%
filter(!(is.na(date) & is.na(poe) &
is.na(entry_screened) & is.na(exit_screened) & is.na(total_typed) &
is.na(alerts_triggered) & is.na(alerts_discarded) & is.na(bodies_moved)))
}
