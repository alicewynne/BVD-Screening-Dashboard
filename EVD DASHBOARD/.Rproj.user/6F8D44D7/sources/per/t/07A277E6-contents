make_stage_weekly_summary <- function(data) {
  data <- data %>%
    filter(!is.na(visit_date), facility_group %in% supported_facilities)
  
  empty_output <- tidyr::expand_grid(
    facility_group = supported_facilities,
    domain = factor(domain_levels, levels = domain_levels),
    period = factor(
      c("Average Previous Weeks", "This Week"),
      levels = c("Average Previous Weeks", "This Week")
    )
  ) %>%
    mutate(
      n = 0,
      percent = 0,
      denominator = 0,
      weeks_in_average = 0,
      label = "0%\n0",
      period_note = "No data available"
    )
  
  if (nrow(data) == 0) return(empty_output)
  
  facility_windows <- data %>%
    group_by(facility_group) %>%
    summarise(latest_facility_date = max(visit_date, na.rm = TRUE), .groups = "drop") %>%
    mutate(
      this_week_start = latest_facility_date - days(6),
      this_week_end = latest_facility_date
    )
  
  data_windowed <- data %>%
    left_join(facility_windows, by = "facility_group") %>%
    mutate(
      analysis_period = if_else(
        visit_date >= this_week_start & visit_date <= this_week_end,
        "This Week",
        "Average Previous Weeks"
      ),
      historical_week = floor_date(visit_date, unit = "week", week_start = 1)
    )
  
  weekly_stage_counts <- data_windowed %>%
    group_by(facility_group, analysis_period, historical_week) %>%
    summarise(
      total_visits = n_distinct(visit_id),
      triage_n = sum(triage_complete_qs, na.rm = TRUE),
      symptoms_n = sum(has_consultation, na.rm = TRUE),
      signs_n = sum(has_physical_exam, na.rm = TRUE),
      impressions_n = sum(has_working_diagnosis, na.rm = TRUE),
      diagnoses_n = sum(has_definitive_diagnosis, na.rm = TRUE),
      investigations_n = sum(has_investigation, na.rm = TRUE),
      management_n = sum(has_management, na.rm = TRUE),
      dcc_diagnosis_accepted_n = sum(definitive_dcc_accepted, na.rm = TRUE),
      dcc_diagnosis_eligible_n = sum(definitive_dcc_eligible, na.rm = TRUE),
      guideline_compliant_n = sum(treatment_guideline_adherent_flag, na.rm = TRUE),
      guideline_eligible_n = sum(treatment_guideline_suggested_flag, na.rm = TRUE),
      diagnostic_variance_changed_n = sum(dx_variance_changed, na.rm = TRUE),
      diagnostic_variance_assessed_n = sum(dx_variance_assessed, na.rm = TRUE),
      .groups = "drop"
    ) %>%
    transmute(
      facility_group, analysis_period, historical_week,
      `Triage` = triage_n,
      `Symptoms` = symptoms_n,
      `Signs` = signs_n,
      `Impressions` = impressions_n,
      `Investigations` = investigations_n,
      `Diagnoses` = diagnoses_n,
      `Management` = management_n,
      `DCC Diagnosis Acceptance` = dcc_diagnosis_accepted_n,
      `Guideline Compliance` = guideline_compliant_n,
      `Diagnostic Variance` = diagnostic_variance_changed_n,
      denominator_triage = total_visits,
      denominator_symptoms = total_visits,
      denominator_signs = total_visits,
      denominator_impressions = total_visits,
      denominator_diagnoses = total_visits,
      denominator_investigations = total_visits,
      denominator_management = total_visits,
      denominator_dcc_diagnosis_acceptance = dcc_diagnosis_eligible_n,
      denominator_guideline_compliance = guideline_eligible_n,
      denominator_diagnostic_variance = diagnostic_variance_assessed_n
    )
  
  numerator_long <- weekly_stage_counts %>%
    select(facility_group, analysis_period, historical_week, all_of(domain_levels)) %>%
    pivot_longer(cols = all_of(domain_levels), names_to = "domain", values_to = "n")
  
  denominator_long <- weekly_stage_counts %>%
    select(facility_group, analysis_period, historical_week, starts_with("denominator_")) %>%
    pivot_longer(
      cols = starts_with("denominator_"),
      names_to = "denominator_code",
      values_to = "denominator"
    ) %>%
    mutate(
      domain = recode(
        denominator_code,
        denominator_triage = "Triage",
        denominator_symptoms = "Symptoms",
        denominator_signs = "Signs",
        denominator_impressions = "Impressions",
        denominator_diagnoses = "Diagnoses",
        denominator_investigations = "Investigations",
        denominator_management = "Management",
        denominator_dcc_diagnosis_acceptance = "DCC Diagnosis Acceptance",
        denominator_guideline_compliance = "Guideline Compliance",
        denominator_diagnostic_variance = "Diagnostic Variance"
      )
    ) %>%
    select(facility_group, analysis_period, historical_week, domain, denominator)
  
  weekly_long <- numerator_long %>%
    left_join(
      denominator_long,
      by = c("facility_group", "analysis_period", "historical_week", "domain")
    ) %>%
    mutate(
      domain = factor(domain, levels = domain_levels),
      percent = safe_pct(n, denominator)
    )
  
  average_previous_weeks <- weekly_long %>%
    filter(analysis_period == "Average Previous Weeks") %>%
    group_by(facility_group, domain) %>%
    summarise(
      period = "Average Previous Weeks",
      n = round(mean(n, na.rm = TRUE), 0),
      denominator = round(mean(denominator, na.rm = TRUE), 0),
      percent = round(mean(percent, na.rm = TRUE), 1),
      weeks_in_average = n_distinct(historical_week),
      period_note = paste0("Average of ", weeks_in_average, " previous week(s) before the latest 7-day reporting window"),
      .groups = "drop"
    )
  
  this_week <- weekly_long %>%
    filter(analysis_period == "This Week") %>%
    group_by(facility_group, domain) %>%
    summarise(
      period = "This Week",
      n = sum(n, na.rm = TRUE),
      denominator = sum(denominator, na.rm = TRUE),
      percent = safe_pct(n, denominator),
      weeks_in_average = 1,
      period_note = "Latest 7-day reporting window for this facility",
      .groups = "drop"
    )
  
  this_week_as_baseline <- this_week %>%
    anti_join(
      average_previous_weeks %>% distinct(facility_group, domain),
      by = c("facility_group", "domain")
    ) %>%
    mutate(
      period = "Average Previous Weeks",
      period_note = "No older week available; baseline uses the available latest 7-day window"
    )
  
  bind_rows(average_previous_weeks, this_week, this_week_as_baseline) %>%
    group_by(facility_group, domain, period) %>%
    slice(1) %>%
    ungroup() %>%
    mutate(
      period = factor(period, levels = c("Average Previous Weeks", "This Week")),
      domain = factor(domain, levels = domain_levels)
    ) %>%
    complete(
      facility_group = supported_facilities,
      domain = factor(domain_levels, levels = domain_levels),
      period = factor(
        c("Average Previous Weeks", "This Week"),
        levels = c("Average Previous Weeks", "This Week")
      ),
      fill = list(
        n = 0,
        denominator = 0,
        percent = 0,
        weeks_in_average = 0,
        period_note = "No data available"
      )
    ) %>%
    mutate(
      n = ifelse(is.na(n) | is.nan(n), 0, n),
      denominator = ifelse(is.na(denominator) | is.nan(denominator), 0, denominator),
      percent = ifelse(is.na(percent) | is.nan(percent), 0, percent),
      label = make_graph_label(percent, n)
    )
}

