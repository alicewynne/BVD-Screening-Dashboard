make_history_metric_cards <- function(summary_data) {
  metric_line <- function(metric_name, label = metric_name, subtitle = NULL) {
    row <- summary_data %>%
      filter(metric == metric_name) %>%
      slice_head(n = 1)
    
    value <- if (nrow(row) == 0) NA_real_ else row$percent[1]
    value_label <- if (is.na(value)) "N/A" else paste0(round(value, 1), "%")
    bar_width <- if (is.na(value)) 0 else max(0, min(100, value))
    bar_color <- if (is.na(value)) "#BFC9D4" else who_mid_blue
    
    tags$div(
      style = "margin-bottom:12px;",
      tags$div(
        style = "display:flex;justify-content:space-between;gap:12px;align-items:flex-end;margin-bottom:5px;",
        tags$div(
          tags$div(style = "font-weight:800;color:#1F2D3D;", label),
          if (!is.null(subtitle)) tags$div(style = "font-size:12px;color:#657786;margin-top:2px;", subtitle)
        ),
        tags$div(style = "font-weight:900;color:#1F2D3D;white-space:nowrap;", value_label)
      ),
      tags$div(
        style = "height:9px;background:#E8EEF5;border-radius:999px;overflow:hidden;",
        tags$div(
          style = paste0(
            "height:100%;width:", bar_width,
            "%;background:", bar_color,
            ";border-radius:999px;transition:width .25s ease;"
          )
        )
      )
    )
  }
  
  history_group <- function(title, lines) {
    tags$div(
      style = "background:#FFFFFF;border:1px solid #DCE3EA;border-radius:14px;padding:18px 18px 8px 18px;margin-bottom:18px;box-shadow:0 1px 4px rgba(0,0,0,.07);",
      tags$div(style = "font-size:17px;font-weight:900;color:#003B5C;margin-bottom:12px;", title),
      lines
    )
  }
  
  fluidRow(
    column(
      width = 12,
      history_group(
        "Past Medical & Surgical History",
        tagList(
          metric_line("Past Medical & Surgical History", "Section completeness"),
          metric_line("Chronic Illnesses Recorded", "Chronic illness"),
          metric_line("Procedures or Surgeries Recorded", "Procedures / surgeries")
        )
      ),
      history_group(
        "Drug & Medication History",
        tagList(
          metric_line("Drug & Medication History", "Section completeness"),
          metric_line("Current Medication Recorded", "Current medication"),
          metric_line("Allergies Recorded", "Allergies"),
          metric_line("Allergy Details Recorded", "Allergy details")
        )
      ),
      history_group(
        "Family History",
        tagList(metric_line("Family History", "Section completeness"))
      ),
      history_group(
        "Personal & Social History",
        tagList(
          metric_line("Personal & Social History", "Section completeness"),
