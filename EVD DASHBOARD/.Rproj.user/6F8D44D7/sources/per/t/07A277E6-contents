has_non_paracetamol_aspirin_text <- function(x) {
  vapply(
    x,
    function(one_text) {
      medication_items <- str_to_lower(parse_medication_items(one_text))
      if (length(medication_items) == 0) {
        return(FALSE)
      }
      any(!str_detect(medication_items, "paracetamol|acetaminophen|aspirin|asprin"))
    },
    logical(1)
  )
}

full_cycle_visit_flag <- function(data) {
  required_columns <- c(
    "triage_complete_qs", "has_consultation", "has_physical_exam",
    "has_working_diagnosis", "has_investigation", "has_definitive_diagnosis",
    "has_management"
  )
  if (nrow(data) == 0 || !all(required_columns %in% names(data))) {
    return(rep(FALSE, nrow(data)))
  }
  data$triage_complete_qs & data$has_consultation & data$has_physical_exam &
    data$has_working_diagnosis & data$has_investigation &
    data$has_definitive_diagnosis & data$has_management
}

# DCC encounters may remain open on a device and then be completed much later,
# creating elapsed times of several days. These are workflow-session gaps, not
# meaningful outpatient stage durations. Operational time indicators therefore
# use non-negative intervals no longer than 24 hours.
valid_operational_minutes <- function(x, maximum_minutes = 1440) {
  x <- as_plain_numeric(x)
  x[is.na(x) | x < 0 | x > maximum_minutes] <- NA_real_
  x
}

make_facility_operations_summary <- function(data) {
  total_visits <- n_distinct(data$visit_id)
  
  completed_flag <- if ("completed_without_dropout_flag" %in% names(data)) {
    to_logical_safe(data$completed_without_dropout_flag)
  } else if ("is_completed_without_dropout" %in% names(data)) {
    to_logical_safe(data$is_completed_without_dropout)
  } else {
    full_cycle_visit_flag(data)
  }
  
  summary_flag <- if ("summary_of_care_reached_flag" %in% names(data)) {
    to_logical_safe(data$summary_of_care_reached_flag)
  } else if ("is_reached_summary_of_care" %in% names(data)) {
    to_logical_safe(data$is_reached_summary_of_care)
  } else {
    completed_flag
  }
  
  dropout_flag <- if ("workflow_dropout_flag" %in% names(data)) {
    to_logical_safe(data$workflow_dropout_flag)
  } else {
    !completed_flag
  }
  
  weekly_caseload <- data %>%
    mutate(week_start = floor_date(visit_date, unit = "week", week_start = 1)) %>%
    filter(!is.na(week_start)) %>%
    count(week_start, name = "visits")
  
  average_caseload_per_week <- if (nrow(weekly_caseload) == 0) {
    NA_real_
  } else {
    round(mean(weekly_caseload$visits, na.rm = TRUE), 1)
  }
  
  full_cycle_data <- data[completed_flag & summary_flag, , drop = FALSE]
  
  valid_visit_times <- valid_operational_minutes(full_cycle_data$visit_duration_minutes)
  average_visit_time <- if (nrow(full_cycle_data) == 0 || all(is.na(valid_visit_times))) {
    NA_real_
  } else {
    round(mean(valid_visit_times, na.rm = TRUE), 1)
  }
  
  dropout_n <- sum(dropout_flag, na.rm = TRUE)
  
  tibble(
    total_visits = total_visits,
    average_caseload_per_week = average_caseload_per_week,
    average_visit_time_minutes = average_visit_time,
    workflow_dropout_n = dropout_n,
    workflow_dropout_pct = safe_pct(dropout_n, total_visits)
  )
}

make_caseload_day_summary <- function(data) {
  day_levels <- c("Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday")
  
  if (nrow(data) == 0) {
    return(tibble(day_of_week = factor(day_levels, levels = day_levels), visits = 0, percent = 0))
  }
  
  data %>%
    mutate(
      day_number = suppressWarnings(as.integer(visit_day_of_week)),
      day_of_week = case_when(
        day_number == 1 ~ "Monday",
        day_number == 2 ~ "Tuesday",
        day_number == 3 ~ "Wednesday",
        day_number == 4 ~ "Thursday",
        day_number == 5 ~ "Friday",
        day_number == 6 ~ "Saturday",
        day_number == 7 ~ "Sunday",
        !is.na(visit_date) ~ weekdays(visit_date),
        TRUE ~ NA_character_
      ),
      day_of_week = factor(day_of_week, levels = day_levels)
    ) %>%
    filter(!is.na(day_of_week)) %>%
    count(day_of_week, name = "visits") %>%
    complete(day_of_week = factor(day_levels, levels = day_levels), fill = list(visits = 0)) %>%
    mutate(percent = safe_pct(visits, sum(visits, na.rm = TRUE)))
}

