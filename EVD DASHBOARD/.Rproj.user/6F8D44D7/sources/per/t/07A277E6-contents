format_compact_percent <- function(value) {
  value <- as_plain_numeric(value)
  vapply(
    value,
    function(x) {
      if (is.na(x)) return("No data")
      rounded <- round(x, 1)
      value_text <- if (abs(rounded - round(rounded)) < 0.05) {
        as.character(round(rounded))
      } else {
        format(rounded, nsmall = 1, trim = TRUE, scientific = FALSE)
      }
      paste0(value_text, "%")
    },
    character(1)
  )
}

