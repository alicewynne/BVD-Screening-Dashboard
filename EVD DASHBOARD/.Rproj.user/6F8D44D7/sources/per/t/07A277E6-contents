make_symptom_long <- function(data) {
  symptom_columns <- intersect(
    names(data),
    c(
      "symptoms_json", "selected_symptoms_json", "presenting_symptoms_json",
      "presenting_complaints_json", "symptom_summary", "presenting_complaint",
      "presenting_complaints", "chief_complaint", "main_complaint", "clinical_symptoms"
    )
  )
  
  empty_output <- tibble(visit_id = numeric(), symptom = character())
  
  if (nrow(data) == 0 || length(symptom_columns) == 0 || !"visit_id" %in% names(data)) {
    return(empty_output)
  }
  
  rows <- lapply(seq_len(nrow(data)), function(i) {
    raw_text <- paste(
      na.omit(as.character(unlist(data[i, symptom_columns, drop = FALSE]))),
      collapse = " ; "
    )
    
    symptoms <- parse_jsonish_items(raw_text)
    symptoms <- symptoms[!is.na(symptoms) & symptoms != ""]
    symptoms <- symptoms[!str_detect(str_to_lower(symptoms), "^(none|unknown|not recorded|yes|no|true|false)$")]
    symptoms <- symptoms[!str_detect(str_to_lower(symptoms), "^\\[?object object\\]?$|object object")]
    symptoms <- unique(symptoms)
    
    if (length(symptoms) == 0) {
      return(NULL)
    }
    
    tibble(visit_id = data$visit_id[i], symptom = symptoms)
  })
  
  rows <- rows[!vapply(rows, is.null, logical(1))]
  
  if (length(rows) == 0) {
    return(empty_output)
  }
  
  symptom_output <- bind_rows(rows)
  
  if (
    nrow(symptom_output) == 0 ||
    !all(c("visit_id", "symptom") %in% names(symptom_output))
  ) {
    return(empty_output)
  }
  
  symptom_output %>%
    distinct(visit_id, symptom)
}
make_symptom_combination_summary <- function(data, top_n = 10) {
  symptom_long <- make_symptom_long(data)
  
  empty_output <- tibble(
    `Symptom Combination` = character(),
    `Common Definitive Diagnosis` = character(),
    `Visits With Combination and Diagnosis` = integer(),
    `All Visits With Combination` = integer(),
    `% Ending in Diagnosis` = numeric()
  )
  
  if (nrow(symptom_long) == 0) {
    return(empty_output)
  }
  
  visit_symptoms <- symptom_long %>%
    group_by(visit_id) %>%
    summarise(symptoms = list(sort(unique(symptom))), .groups = "drop") %>%
    mutate(symptom_count = lengths(symptoms)) %>%
    filter(symptom_count >= 2)
  
  if (nrow(visit_symptoms) == 0) {
    return(empty_output)
  }
  
  combination_rows <- lapply(seq_len(nrow(visit_symptoms)), function(i) {
    symptoms <- visit_symptoms$symptoms[[i]]
    max_size <- min(3, length(symptoms))
    
    combinations <- unlist(
      lapply(2:max_size, function(k) {
        apply(combn(symptoms, k), 2, paste, collapse = " + ")
      }),
      use.names = FALSE
    )
    
    tibble(visit_id = visit_symptoms$visit_id[i], combination = combinations)
  }) %>%
    bind_rows()
  
  if (nrow(combination_rows) == 0) {
    return(empty_output)
  }
  
  top_combinations <- combination_rows %>%
    count(combination, name = "combination_visits", sort = TRUE) %>%
    slice_head(n = top_n)
  
  diagnosis_lookup <- data %>%
    transmute(
      visit_id,
      diagnosis = diagnosis_name_for_display(
        coalesce(
          primary_definitive_diagnosis_display,
          final_diagnosis,
          "Diagnosis not recorded"
        )
      )
    ) %>%
    mutate(
      diagnosis = clean_optional_text(diagnosis),
      diagnosis = if_else(is.na(diagnosis) | diagnosis == "", "Diagnosis not recorded", diagnosis),
      diagnosis = as.character(diagnosis)
    )
  
  combination_rows %>%
    semi_join(top_combinations, by = "combination") %>%
    left_join(diagnosis_lookup, by = "visit_id") %>%
    group_by(combination, diagnosis) %>%
    summarise(`Visits With Combination and Diagnosis` = n_distinct(visit_id), .groups = "drop") %>%
    left_join(top_combinations, by = "combination") %>%
    group_by(combination) %>%
    slice_max(order_by = `Visits With Combination and Diagnosis`, n = 3, with_ties = FALSE) %>%
    ungroup() %>%
    mutate(`% Ending in Diagnosis` = safe_pct(`Visits With Combination and Diagnosis`, combination_visits)) %>%
    arrange(desc(combination_visits), combination, desc(`Visits With Combination and Diagnosis`)) %>%
    transmute(
      `Symptom Combination` = as.character(combination),
      `Common Definitive Diagnosis` = as.character(diagnosis),
      `Visits With Combination and Diagnosis` = as.integer(`Visits With Combination and Diagnosis`),
      `All Visits With Combination` = as.integer(combination_visits),
      `% Ending in Diagnosis` = as.numeric(`% Ending in Diagnosis`)
    )
}
make_diagnosis_management_patterns <- function(data, top_diagnoses = 5, top_treatments = 5) {
  if (nrow(data) == 0) {
    return(tibble(`Definitive Diagnosis` = character(), `Medication Administered` = character(), `Visits` = integer()))
  }
  
  diagnosis_rows <- data %>%
    filter(!is.na(primary_definitive_diagnosis_key), primary_definitive_diagnosis_key != "") %>%
    group_by(primary_definitive_diagnosis_key) %>%
    summarise(
      diagnosis_label = diagnosis_name_for_display(first(primary_definitive_diagnosis_display)),
      diagnosis_visits = n_distinct(visit_id),
      .groups = "drop"
    ) %>%
    arrange(desc(diagnosis_visits), diagnosis_label) %>%
    slice_head(n = top_diagnoses)
  
  if (nrow(diagnosis_rows) == 0) {
    return(tibble(`Definitive Diagnosis` = character(), `Medication Administered` = character(), `Visits` = integer()))
  }
  
  medication_rows <- lapply(seq_len(nrow(data)), function(i) {
    dx_key <- data$primary_definitive_diagnosis_key[i]
    if (is.na(dx_key) || !dx_key %in% diagnosis_rows$primary_definitive_diagnosis_key) {
      return(NULL)
    }
    
    # This field contains drugs actually administered during the visit. The
    # prescription field also contains guideline headings and maximum-dose
    # notes, so it is not valid for a medicine ranking or treatment pattern.
    meds <- parse_medication_items(data$administered_drugs_json[i])
    meds <- unique(meds)
    
    if (length(meds) == 0) {
      return(NULL)
    }
    
    tibble(visit_id = data$visit_id[i], primary_definitive_diagnosis_key = dx_key, medication = meds)
  }) %>% bind_rows()
  
  if (nrow(medication_rows) == 0) {
    return(tibble(`Definitive Diagnosis` = character(), `Medication Administered` = character(), `Visits` = integer()))
  }
  
  medication_rows %>%
    left_join(diagnosis_rows, by = "primary_definitive_diagnosis_key") %>%
    group_by(diagnosis_label, medication) %>%
    summarise(Visits = n_distinct(visit_id), .groups = "drop") %>%
    group_by(diagnosis_label) %>%
    slice_max(order_by = Visits, n = top_treatments, with_ties = FALSE) %>%
    ungroup() %>%
    arrange(diagnosis_label, desc(Visits), medication) %>%
    transmute(
      `Definitive Diagnosis` = diagnosis_label,
      `Medication Administered` = medication,
      `Visits` = Visits
    )
}

make_diagnosis_return_rate_summary <- function(data) {
