make_facility_benchmark_summary <- function(base_data) {
  make_domain_rows <- function(df, group_label, facility_label) {
    total_visits <- n_distinct(df$visit_id)
    tibble(
      group = group_label,
      facility = facility_label,
      domain = domain_levels,
      numerator = c(
        sum(df$triage_complete_qs, na.rm = TRUE),
        sum(df$has_consultation, na.rm = TRUE),
        sum(df$has_physical_exam, na.rm = TRUE),
        sum(df$has_working_diagnosis, na.rm = TRUE),
        sum(df$has_investigation, na.rm = TRUE),
        sum(df$has_definitive_diagnosis, na.rm = TRUE),
        sum(df$has_management, na.rm = TRUE),
        sum(df$definitive_dcc_accepted, na.rm = TRUE),
        sum(df$treatment_guideline_adherent_flag, na.rm = TRUE),
        sum(df$dx_variance_changed, na.rm = TRUE)
      ),
      denominator = c(
        rep(total_visits, 7),
        sum(df$definitive_dcc_eligible, na.rm = TRUE),
        sum(df$treatment_guideline_suggested_flag, na.rm = TRUE),
        sum(df$dx_variance_assessed, na.rm = TRUE)
      )
    ) %>%
      mutate(percent = safe_pct(numerator, denominator), label = make_graph_label(percent, numerator))
  }
  
  south_sudan_average <- make_domain_rows(base_data, "South Sudan average", "South Sudan average")
  
  facility_rows <- base_data %>%
    group_split(facility_group) %>%
    lapply(function(df) {
      make_domain_rows(df, "Facility", unique(df$facility_group)[1])
    }) %>%
    bind_rows()
  
  bind_rows(south_sudan_average, facility_rows) %>%
    mutate(
      domain = factor(domain, levels = domain_levels),
      group = factor(group, levels = c("South Sudan average", "Facility"))
    )
}

