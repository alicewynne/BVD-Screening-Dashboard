# ============================================================

server <- function(input, output, session) {
  # The worker starts with no patient data. The full dataset is loaded only
  # after the first UI flush so shinyapps.io/Posit can mark the worker ready.
  visit_store <- reactiveVal(NULL)
  data_ready <- reactiveVal(FALSE)
  data_loading <- reactiveVal(FALSE)
  data_load_error <- reactiveVal(NULL)
  data_version <- reactiveVal(0L)
  updating_filters <- reactiveVal(FALSE)
  alert_workflow_store <- reactiveVal(empty_alert_workflow_data())
  alert_workflow_version <- reactiveVal(0L)
  alert_logged_in <- reactiveVal(FALSE)
  alert_current_user <- reactiveVal("")
  alert_login_error <- reactiveVal("")
  
  load_dashboard_data <- function(notify_success = FALSE) {
    if (isTRUE(isolate(data_loading()))) {
      return(invisible(FALSE))
    }
    
    had_existing_data <- isTRUE(isolate(data_ready())) &&
      !is.null(isolate(visit_store()))
    
    data_loading(TRUE)
    data_load_error(NULL)
    on.exit(data_loading(FALSE), add = TRUE)
    
    message("DCC data load started at ", format(Sys.time(), "%Y-%m-%d %H:%M:%S %Z"))
    load_started <- Sys.time()
    
    result <- tryCatch(
      {
        # SAME full database query and SAME cleaning logic as the previous app.
        refreshed_visits <- get_visit_data() %>% clean_visit_data()
        
        visit_store(refreshed_visits)
        data_ready(TRUE)
        data_version(isolate(data_version()) + 1L)
        
        # Keep schema/alert initialization out of global worker startup.
        # Attempt it once per worker, then load the existing workflow register.
        if (!isTRUE(dcc_runtime_state$alert_schema_ready)) {
          tryCatch(
            {
              ensure_phe_alert_tables()
              dcc_runtime_state$alert_schema_ready <- TRUE
            },
            error = function(e) {
              message("Alert schema initialization warning: ", conditionMessage(e))
            }
          )
        }
        
        workflow_data <- tryCatch(
          fetch_phe_alert_workflow(),
          error = function(e) {
            message("Alert workflow load warning: ", conditionMessage(e))
            empty_alert_workflow_data()
          }
        )
        alert_workflow_store(workflow_data)
        alert_workflow_version(isolate(alert_workflow_version()) + 1L)
        
        # The previous Maiwut diagnostic is retained but disabled by default in
        # production because it performs two extra database queries. Set
        # DCC_RUN_DIAGNOSTICS=true when you specifically need it.
        if (identical(
          tolower(Sys.getenv("DCC_RUN_DIAGNOSTICS", unset = "false")),
          "true"
        )) {
          diagnose_maiwut_data_path(refreshed_visits)
        }
        
        states <- sort(unique(refreshed_visits$state))
        counties <- sort(unique(refreshed_visits$county))
        facilities <- supported_facilities[
          supported_facilities %in% unique(refreshed_visits$facility_group)
        ]
        bounds <- valid_date_bounds(refreshed_visits)
        
        updating_filters(TRUE)
        updatePickerInput(
          session, "state_filter",
          choices = states,
          selected = states
        )
        updatePickerInput(
          session, "county_filter",
          choices = counties,
          selected = counties
        )
        updatePickerInput(
          session, "selected_facility",
          choices = c(all_facilities_label, facilities),
          selected = all_facilities_label
        )
        updateDateRangeInput(
          session, "date_filter",
          start = bounds$min,
          end = bounds$max,
          min = bounds$min,
          max = bounds$max
        )
        session$onFlushed(function() updating_filters(FALSE), once = TRUE)
        
        elapsed <- round(
          as.numeric(difftime(Sys.time(), load_started, units = "secs")),
          1
        )
        message(
          "DCC data load completed: ", nrow(refreshed_visits),
          " rows in ", elapsed, " seconds."
        )
        
        if (isTRUE(notify_success)) {
          showNotification(
            "DCC dashboard data refreshed successfully.",
            type = "message",
            duration = 5
          )
        }
        
        TRUE
      },
      error = function(e) {
        error_message <- conditionMessage(e)
        data_load_error(error_message)
        message("DCC DATA LOAD FAILED: ", error_message)
        
        # A failed manual refresh never destroys an already working dashboard.
        if (!had_existing_data) {
          data_ready(FALSE)
          visit_store(NULL)
        }
        
        showNotification(
          paste("DCC database could not be loaded:", error_message),
          type = "error",
          duration = NULL
        )
        FALSE
      }
    )
    
    invisible(result)
  }
  
  # First load occurs only after the browser has received the initial UI.
  # This is the key change that avoids the 60-second worker-startup timeout.
  session$onFlushed(
    function() {
      load_dashboard_data(notify_success = FALSE)
    },
    once = TRUE
  )
  
  observeEvent(input$refresh_data, {
    load_dashboard_data(notify_success = TRUE)
  }, ignoreInit = TRUE)
  
  observeEvent(input$state_filter, {
    if (!isTRUE(isolate(data_ready()))) return()
    if (isTRUE(updating_filters())) return()
    data <- visit_store()
    if (!is.null(input$state_filter) && length(input$state_filter) > 0) data <- data %>% filter(state %in% input$state_filter)
    available_counties <- sort(unique(data$county))
    updatePickerInput(session, "county_filter", choices = available_counties, selected = available_counties)
  }, ignoreInit = TRUE)
  
  observeEvent(list(input$state_filter, input$county_filter), {
    if (!isTRUE(isolate(data_ready()))) return()
    if (isTRUE(updating_filters())) return()
    data <- visit_store()
    if (!is.null(input$state_filter) && length(input$state_filter) > 0) data <- data %>% filter(state %in% input$state_filter)
    if (!is.null(input$county_filter) && length(input$county_filter) > 0) data <- data %>% filter(county %in% input$county_filter)
    
    available_facilities <- supported_facilities[supported_facilities %in% unique(data$facility_group)]
    all_loaded_facilities <- supported_facilities[supported_facilities %in% unique(visit_store()$facility_group)]
    current_selection <- isolate(input$selected_facility)
    next_selection <- if (!is.null(current_selection) && current_selection %in% all_loaded_facilities) current_selection else all_facilities_label
    
    updatePickerInput(
      session, "selected_facility",
      choices = c(all_facilities_label, all_loaded_facilities),
      selected = next_selection
    )
  }, ignoreInit = TRUE)
  
  observeEvent(input$selected_facility, {
    if (!isTRUE(isolate(data_ready()))) return()
    if (isTRUE(updating_filters())) return()
    if (is.null(input$selected_facility) || is.na(input$selected_facility) || input$selected_facility == all_facilities_label) return()
    
    data <- visit_store()
    facility_data <- data %>% filter(facility_group == input$selected_facility)
    if (nrow(facility_data) == 0) return()
    
    selected_states <- sort(unique(facility_data$state))
    selected_counties <- sort(unique(facility_data$county))
    county_choices <- data %>% filter(state %in% selected_states) %>% pull(county) %>% unique() %>% sort()
    
    facility_bounds <- valid_date_bounds(facility_data)
    current_dates <- isolate(input$date_filter)
    dates_overlap <- !is.null(current_dates) &&
      length(current_dates) == 2 &&
      !any(is.na(current_dates)) &&
      as.Date(current_dates[2]) >= facility_bounds$min &&
      as.Date(current_dates[1]) <= facility_bounds$max
    
    updating_filters(TRUE)
    updatePickerInput(session, "state_filter", choices = sort(unique(data$state)), selected = selected_states)
    updatePickerInput(session, "county_filter", choices = county_choices, selected = selected_counties)
    if (!isTRUE(dates_overlap)) {
      updateDateRangeInput(
        session,
        "date_filter",
        start = facility_bounds$min,
        end = facility_bounds$max,
        min = valid_date_bounds(data)$min,
        max = valid_date_bounds(data)$max
      )
    }
    session$onFlushed(function() updating_filters(FALSE), once = TRUE)
  }, ignoreInit = TRUE)
  
  base_filtered_data <- reactive({
    req(data_ready())
    data <- visit_store()
    req(!is.null(data))
    if (!is.null(input$state_filter) && length(input$state_filter) > 0) data <- data %>% filter(state %in% input$state_filter)
    if (!is.null(input$county_filter) && length(input$county_filter) > 0) data <- data %>% filter(county %in% input$county_filter)
    req(input$date_filter)
    data %>% filter(visit_date >= input$date_filter[1], visit_date <= input$date_filter[2])
  }) %>%
    bindCache(data_version(), input$state_filter, input$county_filter, input$date_filter)
  
  overview_filtered_data <- reactive({
    data <- base_filtered_data()
    if (!is.null(input$selected_facility) && !is.na(input$selected_facility) && input$selected_facility != all_facilities_label) {
      data <- data %>% filter(facility_group == input$selected_facility)
    }
    data
  }) %>%
    bindCache(data_version(), input$state_filter, input$county_filter, input$date_filter, input$selected_facility)
  
  selected_facility_name_for_analytics <- reactive({
    facilities <- supported_facilities[supported_facilities %in% unique(base_filtered_data()$facility_group)]
    if (!is.null(input$selected_facility) && !is.na(input$selected_facility) && input$selected_facility != all_facilities_label) return(input$selected_facility)
    if (default_facility %in% facilities) return(default_facility)
    if (length(facilities) > 0) return(facilities[1])
    default_facility
  }) %>%
    bindCache(data_version(), input$state_filter, input$county_filter, input$date_filter, input$selected_facility)
  
  selected_facility_data <- reactive({
    base_filtered_data() %>% filter(facility_group == selected_facility_name_for_analytics())
  }) %>%
    bindCache(data_version(), input$state_filter, input$county_filter, input$date_filter, input$selected_facility)
  
  portfolio_summary <- reactive({ calculate_portfolio_summary(overview_filtered_data()) }) %>%
    bindCache(data_version(), input$state_filter, input$county_filter, input$date_filter, input$selected_facility)
  county_summary <- reactive({ calculate_county_summary(base_filtered_data()) }) %>%
    bindCache(data_version(), input$state_filter, input$county_filter, input$date_filter)
  facility_summary <- reactive({ calculate_facility_summary(base_filtered_data()) }) %>%
    bindCache(data_version(), input$state_filter, input$county_filter, input$date_filter)
  metric_long <- reactive({ make_metric_long(selected_facility_data()) }) %>%
    bindCache(data_version(), input$state_filter, input$county_filter, input$date_filter, input$selected_facility)
  county_metric_long <- reactive({ make_county_metric_long(base_filtered_data()) }) %>%
    bindCache(data_version(), input$state_filter, input$county_filter, input$date_filter)
  triage_component_summary <- reactive({ make_triage_component_summary(selected_facility_data()) }) %>%
    bindCache(data_version(), input$state_filter, input$county_filter, input$date_filter, input$selected_facility)
