  )
}

update_phe_alert_status <- function(
    alert_key,
    new_status,
    assigned_to,
    note,
    changed_by
) {
  allowed_statuses <- c("open", "follow_up", "cleared", "discarded")
  
  if (!new_status %in% allowed_statuses) {
    stop("Invalid alert status.", call. = FALSE)
  }
  
  assigned_to_clean <- trimws(as.character(assigned_to))
  note_clean <- trimws(as.character(note))
  if (!nzchar(assigned_to_clean)) assigned_to_clean <- NA_character_
  if (!nzchar(note_clean)) note_clean <- NA_character_
  
  con <- connect_db()
  on.exit(DBI::dbDisconnect(con), add = TRUE)
  
  DBI::dbWithTransaction(con, {
    existing <- DBI::dbGetQuery(
      con,
      "SELECT status FROM dcc_phe_alert_workflow WHERE alert_key = $1 FOR UPDATE",
      params = list(as.character(alert_key))
    )
    
    if (nrow(existing) != 1) {
      stop("The selected alert could not be found.", call. = FALSE)
    }
    
    old_status <- as.character(existing$status[1])
    
    DBI::dbExecute(
      con,
      "
      UPDATE dcc_phe_alert_workflow
      SET
        status = $2,
        assigned_to = $3,
        follow_up_note = $4,
        updated_by = $5,
        updated_at = CURRENT_TIMESTAMP,
        cleared_at = CASE
          WHEN $2 IN ('cleared', 'discarded') THEN CURRENT_TIMESTAMP
          ELSE NULL
        END
      WHERE alert_key = $1
      ",
      params = list(
        as.character(alert_key),
        as.character(new_status),
        assigned_to_clean,
        note_clean,
        as.character(changed_by)
      )
    )
    
    DBI::dbExecute(
      con,
      "
      INSERT INTO dcc_phe_alert_history (
        alert_key, old_status, new_status, note, assigned_to, changed_by
      ) VALUES ($1, $2, $3, $4, $5, $6)
      ",
      params = list(
        as.character(alert_key),
        old_status,
        as.character(new_status),
        note_clean,
        assigned_to_clean,
        as.character(changed_by)
      )
    )
  })
  
  invisible(TRUE)
}

attach_alert_workflow <- function(alert_rows, workflow_data) {
  if (nrow(alert_rows) == 0) {
    return(
      alert_rows %>%
        mutate(
          status = character(),
          assigned_to = character(),
          follow_up_note = character(),
          updated_by = character(),
          updated_at = as.POSIXct(character()),
          cleared_at = as.POSIXct(character())
        )
    )
  }
  
  if (is.null(workflow_data) || nrow(workflow_data) == 0) {
    return(
      alert_rows %>%
        mutate(
          status = "open",
          assigned_to = NA_character_,
          follow_up_note = NA_character_,
          updated_by = NA_character_,
          updated_at = as.POSIXct(NA_character_, tz = "Africa/Juba"),
          cleared_at = as.POSIXct(NA_character_, tz = "Africa/Juba")
        )
    )
  }
  
  alert_rows %>%
    left_join(
      workflow_data %>%
        select(
          alert_key,
          status,
          assigned_to,
          follow_up_note,
          updated_by,
          updated_at,
          cleared_at
        ),
      by = "alert_key"
    ) %>%
    mutate(status = coalesce(status, "open"))
}

# Combines every PHE signal detected from final_diagnosis with the persistent
# workflow register. This ensures that a signal shown in the blinking banner
# is also visible immediately in Alert Management, even before a manual refresh.
# Historical cleared alerts remain in the register and are never deleted.
build_phe_alert_register <- function(data, workflow_data = NULL) {
  detected_alerts <- make_phe_alert_rows(data) %>%
    attach_alert_workflow(workflow_data) %>%
    mutate(detected_in_current_data = TRUE)
  
  if (is.null(workflow_data) || nrow(workflow_data) == 0) {
    return(detected_alerts)
  }
  
  historical_alerts <- workflow_data %>%
    anti_join(
      detected_alerts %>% select(alert_key),
      by = "alert_key"
    ) %>%
    transmute(
      alert_key,
      visit_id,
      alert_date,
      facility_group,
      state,
      county,
      diagnosis_code,
      diagnosis_label,
      diagnosis_key,
      status,
      assigned_to,
      follow_up_note,
      updated_by,
      updated_at,
      cleared_at,
      detected_in_current_data = FALSE
    )
  
  bind_rows(detected_alerts, historical_alerts) %>%
    distinct(alert_key, .keep_all = TRUE)
}


latest_week_bounds <- function(data) {
  dates <- data$visit_date[!is.na(data$visit_date)]
  
  if (length(dates) == 0) {
    return(list(
      anchor = as.Date(NA),
      current_start = as.Date(NA),
      current_end = as.Date(NA),
      previous_start = as.Date(NA),
      previous_end = as.Date(NA),
      reference_30_start = as.Date(NA),
      reference_30_end = as.Date(NA)
    ))
  }
  
  anchor <- max(dates)
  
  list(
    anchor = anchor,
    current_start = anchor - days(6),
    current_end = anchor,
    previous_start = anchor - days(13),
    previous_end = anchor - days(7),
    reference_30_start = anchor - days(36),
    reference_30_end = anchor - days(7)
  )
}

make_top_diagnoses_summary <- function(data, top_n = 5) {
  bounds <- latest_week_bounds(data)
  
  if (is.na(bounds$anchor)) {
    return(tibble(
      rank = integer(),
      diagnosis_code = character(),
      diagnosis_label = character(),
      diagnosis_key = character(),
      cases = integer(),
      percent_consultations = numeric(),
      is_new_from_last_week = logical()
    ))
  }
  
  current_data <- data %>%
    filter(
      visit_date >= bounds$current_start,
      visit_date <= bounds$current_end
    )
  
  previous_data <- data %>%
    filter(
      visit_date >= bounds$previous_start,
      visit_date <= bounds$previous_end
    )
  
  current_diagnoses <- make_diagnosis_long(current_data)
  previous_diagnoses <- make_diagnosis_long(previous_data)
  denominator <- n_distinct(current_data$visit_id)
  
  if (nrow(current_diagnoses) == 0 || denominator == 0) {
    return(tibble(
      rank = integer(),
      diagnosis_code = character(),
      diagnosis_label = character(),
      diagnosis_key = character(),
      cases = integer(),
      percent_consultations = numeric(),
      is_new_from_last_week = logical()
    ))
  }
  
  previous_keys <- unique(previous_diagnoses$diagnosis_key)
  
  current_diagnoses %>%
    group_by(diagnosis_key) %>%
    summarise(
      diagnosis_code = paste(
        sort(unique(na.omit(diagnosis_code))),
        collapse = ", "
      ),
      diagnosis_label = first(diagnosis_label),
      cases = n_distinct(visit_id),
      .groups = "drop"
    ) %>%
    mutate(
      diagnosis_code = if_else(diagnosis_code == "", NA_character_, diagnosis_code),
      percent_consultations = safe_pct(cases, denominator),
      is_new_from_last_week = !diagnosis_key %in% previous_keys
    ) %>%
    arrange(desc(cases), diagnosis_label) %>%
    slice_head(n = top_n) %>%
    mutate(rank = row_number()) %>%
    select(
      rank,
      diagnosis_code,
      diagnosis_label,
      diagnosis_key,
      cases,
      percent_consultations,
      is_new_from_last_week
    )
}


make_top10_morbidity_summary <- function(data, cohort = "Overall", top_n = 10) {
  empty_output <- tibble(
    rank = integer(),
    diagnosis_code = character(),
    diagnosis_label = character(),
    completed_visits = integer(),
    percent_completed_visits = numeric()
  )
  
  if (nrow(data) == 0) {
    return(empty_output)
  }
  
  completed_data <- data %>%
    filter(completed_visit) %>%
    mutate(
      # The title field is preferred because it contains the clinical label
      # without the ICD prefix. The label and final-diagnosis fields remain
      # fallbacks for older records.
      morbidity_title_raw = clean_optional_text(primary_definitive_diagnosis_title),
      morbidity_label_raw = clean_optional_text(primary_definitive_diagnosis_label),
      morbidity_final_raw = clean_optional_text(final_diagnosis),
      morbidity_fallback = coalesce(morbidity_label_raw, morbidity_final_raw),
      morbidity_fallback = str_split_fixed(
        normalize_malaria_diagnosis_text(morbidity_fallback),
        "\\s*;\\s*",
        2
      )[, 1],
      morbidity_source = coalesce(morbidity_title_raw, morbidity_fallback),
      morbidity_primary_available = !is.na(clean_optional_text(primary_definitive_icd_code)) |
        !is.na(morbidity_title_raw) |
        !is.na(morbidity_label_raw),
      morbidity_detection_text = if_else(
        morbidity_primary_available,
        paste(
          coalesce(clean_optional_text(primary_definitive_icd_code), ""),
          coalesce(morbidity_title_raw, ""),
          coalesce(morbidity_label_raw, "")
        ),
        coalesce(morbidity_fallback, "")
      ),
      morbidity_is_malaria = is_malaria_diagnosis_text(
        morbidity_detection_text
      ),
      morbidity_code = coalesce(
        clean_optional_text(primary_definitive_icd_code),
        extract_primary_icd_code(morbidity_label_raw),
        extract_primary_icd_code(morbidity_fallback)
      ),
      morbidity_code = normalize_primary_icd_code(morbidity_code, morbidity_source),
      morbidity_code = if_else(morbidity_is_malaria, "1F4Z", morbidity_code),
      morbidity_label = normalize_primary_diagnosis_label(morbidity_source, morbidity_code),
      morbidity_label = if_else(morbidity_is_malaria, "Malaria", morbidity_label),
      morbidity_key = morbidity_label %>%
        str_to_lower() %>%
        str_replace_all("[^[:alnum:]]+", " ") %>%
        str_squish()
    )
  
  if (identical(cohort, "Maternal")) {
    completed_data <- completed_data %>%
      filter(triage_pregnant | morbidity_maternal_cohort) %>%
      filter(
        !is_primary_pregnancy_diagnosis,
        !morbidity_key %in% c("pregnancy")
      )
  } else if (identical(cohort, "Under 5")) {
    completed_data <- completed_data %>% filter(age_under_5 | age_cohort == "Under 5")
  } else if (identical(cohort, "5 to 11")) {
    completed_data <- completed_data %>% filter(age_5_11 | age_cohort == "5 to 11")
  } else if (identical(cohort, "12 to 24")) {
    completed_data <- completed_data %>% filter(age_12_24 | age_cohort == "12 to 24")
  } else if (identical(cohort, "25 to 60")) {
    completed_data <- completed_data %>% filter(age_25_60 | age_cohort == "25 to 60")
  } else if (identical(cohort, "60 plus")) {
    completed_data <- completed_data %>% filter(age_60_plus | age_cohort == "60 plus")
  }
  
  morbidity_data <- completed_data %>%
    mutate(
      has_primary_morbidity = !is.na(morbidity_code) | !is.na(morbidity_label)
    ) %>%
    filter(has_primary_morbidity)
  
  # Top 10 morbidity percentages should be calculated among completed visits
  # with a recorded primary morbidity in the selected cohort. Using all completed
  # visits as the denominator can make valid large counts round to 0.0% when
  # many completed visits have no usable primary diagnosis field.
  denominator <- n_distinct(morbidity_data$visit_id)
  
  if (nrow(morbidity_data) == 0 || denominator == 0) {
    return(empty_output)
  }
  
  morbidity_data %>%
    mutate(
      morbidity_code = if_else(
        is.na(morbidity_code) | morbidity_code == "",
        "No ICD-11 code recorded",
        morbidity_code
      ),
      morbidity_label = if_else(
        is.na(morbidity_label) | morbidity_label == "",
        "Diagnosis label not recorded",
        morbidity_label
      )
    ) %>%
    # Group by the cleaned clinical name, not the source ICD code. This is
    # essential for malaria because legacy records use several malaria codes.
    group_by(morbidity_key) %>%
    summarise(
      morbidity_label = first(morbidity_label),
      morbidity_code = first(morbidity_code),
      completed_visits = n_distinct(visit_id),
      .groups = "drop"
    ) %>%
    mutate(
      percent_completed_visits = round(
        (as_plain_numeric(completed_visits) / as_plain_numeric(denominator)) * 100,
        1
      )
    ) %>%
    arrange(desc(completed_visits), morbidity_label) %>%
    slice_head(n = top_n) %>%
    mutate(rank = row_number()) %>%
    transmute(
      rank,
      diagnosis_code = morbidity_code,
      diagnosis_label = morbidity_label,
      completed_visits,
      percent_completed_visits
    )
}

