      # age-specific morbidity tabs from becoming empty when patient_age is NA.
      age_cohort = case_when(
        age_under_5 ~ "Under 5",
        age_5_11 ~ "5 to 11",
        age_12_24 ~ "12 to 24",
        age_25_60 ~ "25 to 60",
        age_60_plus ~ "60 plus",
        age_band_key %in% c("u5", "under_5", "under5") ~ "Under 5",
        age_band_key %in% c("5_11", "5_to_11") ~ "5 to 11",
        age_band_key %in% c("12_24", "12_to_24") ~ "12 to 24",
        age_band_key %in% c("25_60", "25_to_60") ~ "25 to 60",
        age_band_key %in% c("60p", "60_plus", "60_and_above") ~ "60 plus",
        !is.na(patient_age) & patient_age < 5 ~ "Under 5",
        !is.na(patient_age) & patient_age <= 11 ~ "5 to 11",
        !is.na(patient_age) & patient_age <= 24 ~ "12 to 24",
        !is.na(patient_age) & patient_age <= 60 ~ "25 to 60",
        !is.na(patient_age) & patient_age > 60 ~ "60 plus",
        TRUE ~ "Unknown"
      )
    ) %>%
    filter(
      !is.na(visit_date),
      is_real_current_facility,
      facility_group %in% supported_facilities,
      !str_detect(facility_clean, "juba military hospital"),
      !str_detect(device_clean, "juba military hospital")
    )
