# Resolve each logo to an absolute file path and expose it through an explicit
# Shiny resource path. This is more reliable than a plain relative URL when the
# application is opened in an external browser, launched from another working
# directory, or hosted below a URL sub-path.
find_dcc_logo_file <- function(filename) {
  frame_files <- unlist(
    lapply(
      sys.frames(),
      function(frame) {
        if (is.null(frame$ofile)) character() else as.character(frame$ofile)
      }
    ),
    use.names = FALSE
  )
  
  command_file <- sub(
    "^--file=",
    "",
    grep("^--file=", commandArgs(trailingOnly = FALSE), value = TRUE)
  )
  
  rstudio_directory <- character()
  if (
    requireNamespace("rstudioapi", quietly = TRUE) &&
    isTRUE(tryCatch(rstudioapi::isAvailable(), error = function(e) FALSE))
  ) {
    active_path <- tryCatch(
      rstudioapi::getSourceEditorContext()$path,
      error = function(e) ""
    )
    if (nzchar(active_path)) {
      rstudio_directory <- dirname(active_path)
    }
  }
  
  app_directory_env <- Sys.getenv("DCC_APP_DIR", unset = "")
  
  root_candidates <- unique(c(
    getwd(),
    if (nzchar(app_directory_env)) app_directory_env else character(),
    dirname(frame_files[file.exists(frame_files)]),
    dirname(command_file[file.exists(command_file)]),
    rstudio_directory,
    file.path(getwd(), ".."),
    file.path(getwd(), "../..")
  ))
  
  root_candidates <- unique(normalizePath(
    root_candidates[nzchar(root_candidates)],
    winslash = "/",
    mustWork = FALSE
  ))
  
  candidate_directories <- unique(c(
    file.path(root_candidates, "www"),
    root_candidates
  ))
  
  exact_candidates <- unique(file.path(candidate_directories, filename))
  exact_matches <- exact_candidates[file.exists(exact_candidates)]
  
  if (length(exact_matches) > 0) {
    return(normalizePath(exact_matches[1], winslash = "/", mustWork = TRUE))
  }
  
  logo_stem <- tools::file_path_sans_ext(basename(filename))
  flexible_matches <- unlist(
    lapply(
      candidate_directories[dir.exists(candidate_directories)],
      function(directory) {
        list.files(
          directory,
          pattern = paste0("^", logo_stem, "\\.(png|jpe?g|webp|gif|svg)$"),
          ignore.case = TRUE,
          full.names = TRUE
        )
      }
    ),
    use.names = FALSE
  )
  
  flexible_matches <- flexible_matches[file.exists(flexible_matches)]
  
  if (length(flexible_matches) > 0) {
    return(normalizePath(flexible_matches[1], winslash = "/", mustWork = TRUE))
  }
  
  stop(
    paste0(
      "Required dashboard logo was not found: ", filename, "\n",
      "Place the file inside the www folder next to app.R, for example:\n",
      "  <dashboard folder>/www/", filename, "\n",
      "The app is stopping instead of opening with an invisible logo."
    ),
    call. = FALSE
  )
}

register_dcc_logo_resource <- function(prefix, logo_path) {
  existing_resources <- shiny::resourcePaths()
  if (prefix %in% names(existing_resources)) {
    shiny::removeResourcePath(prefix)
  }
  
  shiny::addResourcePath(
    prefix = prefix,
    directoryPath = dirname(logo_path)
  )
  
  modified_time <- suppressWarnings(as.numeric(file.info(logo_path)$mtime))
  cache_key <- ifelse(is.na(modified_time), as.numeric(Sys.time()), modified_time)
  
  paste0(
    prefix,
    "/",
    utils::URLencode(basename(logo_path), reserved = TRUE),
    "?v=",
    format(cache_key, scientific = FALSE, trim = TRUE)
  )
}

