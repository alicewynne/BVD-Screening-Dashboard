      geom_text(aes(label = label), vjust = -0.4, size = graph_data_label_size, fontface = "bold", color = who_dark_blue, check_overlap = TRUE) +
      scale_y_continuous(labels = comma, expand = expansion(mult = c(0, 0.18))) +
      labs(x = NULL, y = "Visits") +
      theme_minimal(base_size = 13) +
      theme(axis.text.x = element_text(face = "bold", angle = 25, hjust = 1), plot.margin = margin(10, 35, 10, 10))
    
