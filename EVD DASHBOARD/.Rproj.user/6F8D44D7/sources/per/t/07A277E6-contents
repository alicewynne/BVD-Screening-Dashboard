        paste0("Suspected cases with ", test_name, " ordered."),
        paste0("Definitive diagnosis without ", test_name, " ordered."),
        paste0("Definitive diagnosis with positive result proxy for ", test_name, "."),
        "Definitive diagnosis with is_guideline_toggle_administered TRUE; the database flag excludes Paracetamol and Aspirin."
      )
    )
  }))
