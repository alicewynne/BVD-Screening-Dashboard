calculate_portfolio_summary <- function(data) {
  total_visits <- n_distinct(data$visit_id)
  definitive_dcc_eligible_n <- sum(data$definitive_dcc_eligible, na.rm = TRUE)
  definitive_dcc_accepted_n <- sum(data$definitive_dcc_accepted, na.rm = TRUE)
  guideline_eligible_n <- sum(data$treatment_guideline_suggested_flag, na.rm = TRUE)
  guideline_compliant_n <- sum(data$treatment_guideline_adherent_flag, na.rm = TRUE)
  dx_variance_assessed_n <- sum(data$dx_variance_assessed, na.rm = TRUE)
  dx_variance_changed_n <- sum(data$dx_variance_changed, na.rm = TRUE)
  
  tibble(
    total_facilities = n_distinct(data$facility_group),
    total_counties = n_distinct(data$county),
    total_visits = total_visits,
    completed_visits = sum(data$completed_visit, na.rm = TRUE),
    completion_rate_pct = safe_pct(sum(data$completed_visit, na.rm = TRUE), total_visits),
    triage_pct = safe_pct(sum(data$triage_complete_qs, na.rm = TRUE), total_visits),
    symptoms_pct = safe_pct(sum(data$has_consultation, na.rm = TRUE), total_visits),
    signs_pct = safe_pct(sum(data$has_physical_exam, na.rm = TRUE), total_visits),
    impressions_pct = safe_pct(sum(data$has_working_diagnosis, na.rm = TRUE), total_visits),
    diagnoses_pct = safe_pct(sum(data$has_definitive_diagnosis, na.rm = TRUE), total_visits),
    investigations_pct = safe_pct(sum(data$has_investigation, na.rm = TRUE), total_visits),
    management_pct = safe_pct(sum(data$has_management, na.rm = TRUE), total_visits),
    dcc_diagnosis_acceptance_pct = safe_pct(definitive_dcc_accepted_n, definitive_dcc_eligible_n),
    guideline_compliance_pct = safe_pct(guideline_compliant_n, guideline_eligible_n),
    diagnostic_variance_pct = safe_pct(dx_variance_changed_n, dx_variance_assessed_n),
    female_visits = sum(data$gender == "Female", na.rm = TRUE),
    male_visits = sum(data$gender == "Male", na.rm = TRUE),
    under5_visits = sum(data$age_cohort == "Under 5", na.rm = TRUE),
    age_5_11_visits = sum(data$age_cohort == "5 to 11", na.rm = TRUE),
    age_12_24_visits = sum(data$age_cohort == "12 to 24", na.rm = TRUE),
    age_25_60_visits = sum(data$age_cohort == "25 to 60", na.rm = TRUE),
    age_60_plus_visits = sum(data$age_cohort == "60 plus", na.rm = TRUE)
  )
}

