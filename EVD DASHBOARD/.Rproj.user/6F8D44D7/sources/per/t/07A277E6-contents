    if (!field_available(availability_flag)) return(NA_real_)
    sum(flag, na.rm = TRUE)
  }
  denominator_if_available <- function(flag, availability_flag) {
    count_if_available(flag, availability_flag)
  }
  
  pms_denominator <- denominator_if_available(
    data$hist_pms_section_done,
    data$hist_pms_section_done_available
