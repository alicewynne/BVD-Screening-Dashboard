# PostgreSQL BIGINT/COUNT values can arrive as integer64; normalise before calculations,
# value boxes, plot labels, and DT tables.
as_plain_numeric <- function(x) {
  if (inherits(x, "integer64")) {
    return(suppressWarnings(as.numeric(x)))
  }
  if (is.factor(x)) {
    return(suppressWarnings(as.numeric(as.character(x))))
  }
  suppressWarnings(as.numeric(x))
}

# Mask scales::comma() with an integer64-safe wrapper.
comma <- function(x, ...) {
  scales::comma(as_plain_numeric(x), ...)
}

safe_pct <- function(numerator, denominator) {
  numerator <- as_plain_numeric(numerator)
  denominator <- as_plain_numeric(denominator)
  
  # Explicitly recycle a scalar denominator to every numerator before applying
  # the validity test. Base ifelse() uses the length of its test argument; when
  # that test was a single TRUE value, only the first diagnosis percentage was
  # returned and dplyr recycled it across the entire table.
  output_length <- max(length(numerator), length(denominator))
  if (output_length == 0) {
    return(numeric())
  }
  
  numerator <- rep_len(numerator, output_length)
  denominator <- rep_len(denominator, output_length)
  percentage <- rep(NA_real_, output_length)
  valid <- !is.na(numerator) & !is.na(denominator) & denominator > 0
  percentage[valid] <- round(
    (numerator[valid] / denominator[valid]) * 100,
    1
  )
  percentage
}

display_pct <- function(value) {
  value <- as_plain_numeric(value)
  ifelse(is.na(value), "No data", paste0(round(value, 1), "%"))
}

safe_date <- function(x) {
  x_chr <- trimws(as.character(x))
  x_chr[x_chr %in% c("", "NA", "NaN", "NULL", "null", "None", "none")] <- NA_character_
  out <- rep(as.Date(NA), length(x_chr))
  
  idx_ymd <- !is.na(x_chr) & grepl("^\\d{4}-\\d{2}-\\d{2}", x_chr)
  if (any(idx_ymd)) out[idx_ymd] <- suppressWarnings(as.Date(substr(x_chr[idx_ymd], 1, 10)))
  
  idx_ym <- is.na(out) & !is.na(x_chr) & grepl("^\\d{4}-\\d{2}$", x_chr)
  if (any(idx_ym)) out[idx_ym] <- suppressWarnings(as.Date(paste0(x_chr[idx_ym], "-01")))
  
  idx_ymd_slash <- is.na(out) & !is.na(x_chr) & grepl("^\\d{4}/\\d{2}/\\d{2}", x_chr)
  if (any(idx_ymd_slash)) {
    out[idx_ymd_slash] <- suppressWarnings(as.Date(gsub("/", "-", substr(x_chr[idx_ymd_slash], 1, 10))))
  }
  
  idx_dmy_slash <- is.na(out) & !is.na(x_chr) & grepl("^\\d{2}/\\d{2}/\\d{4}", x_chr)
  if (any(idx_dmy_slash)) out[idx_dmy_slash] <- as.Date(suppressWarnings(lubridate::dmy(x_chr[idx_dmy_slash])))
  
  idx_fallback <- is.na(out) & !is.na(x_chr)
  if (any(idx_fallback)) {
    parsed <- suppressWarnings(lubridate::ymd(x_chr[idx_fallback]))
    still_na <- is.na(parsed)
    if (any(still_na)) parsed[still_na] <- suppressWarnings(lubridate::dmy(x_chr[idx_fallback][still_na]))
    still_na <- is.na(parsed)
    if (any(still_na)) parsed[still_na] <- suppressWarnings(lubridate::mdy(x_chr[idx_fallback][still_na]))
    out[idx_fallback] <- as.Date(parsed)
  }
  
  out
}

to_logical_safe <- function(x) {
  x_chr <- tolower(trimws(as.character(x)))
  case_when(
    x_chr %in% c("true", "t", "1", "yes", "y") ~ TRUE,
    x_chr %in% c("false", "f", "0", "no", "n") ~ FALSE,
    suppressWarnings(!is.na(as.numeric(x_chr)) & as.numeric(x_chr) > 0) ~ TRUE,
    TRUE ~ FALSE
  )
}

clean_text <- function(x, unknown_label) {
  x <- str_trim(as.character(x))
  x <- if_else(
    is.na(x) | x == "" | tolower(x) %in% c("na", "null", "none"),
    unknown_label,
    x
  )
  str_to_title(x)
}

clean_gender_as_female_default <- function(x) {
  x_chr <- tolower(trimws(as.character(x)))
  case_when(
    x_chr %in% c("male", "m", "man", "boy") ~ "Male",
    x_chr %in% c("female", "f", "woman", "girl") ~ "Female",
