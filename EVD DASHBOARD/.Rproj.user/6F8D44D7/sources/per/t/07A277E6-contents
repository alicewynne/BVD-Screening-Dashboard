# ggplot2 fontface settings are not always retained after conversion to Plotly.
# This function identifies only the Plotly traces used for visible data labels
# and enforces a genuinely bold font without altering hover-tooltip traces.
bold_plotly_data_labels <- function(plot_object) {
  built_plot <- plotly::plotly_build(plot_object)
  
  if (is.null(built_plot$x$data) || length(built_plot$x$data) == 0) {
    return(built_plot)
  }
  
  for (trace_index in seq_along(built_plot$x$data)) {
    trace <- built_plot$x$data[[trace_index]]
    trace_mode <- if (is.null(trace$mode)) "" else as.character(trace$mode)
    
    if (grepl("text", trace_mode, fixed = TRUE)) {
      existing_textfont <- if (is.null(trace$textfont)) list() else trace$textfont
      existing_textfont$family <- "Arial Black, Arial, Helvetica, sans-serif"
      built_plot$x$data[[trace_index]]$textfont <- existing_textfont
    }
  }
  
  built_plot
}

