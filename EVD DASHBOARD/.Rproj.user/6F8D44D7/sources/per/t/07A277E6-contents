    "Urinary Tract Infection", "uti",
    "Lower Respiratory Tract Infection", "lrti",
    "Upper Respiratory Tract Infection", "urti",
    "Typhoid", "typhoid"
  )
  
  if (nrow(data) == 0) {
    return(conditions %>% transmute(
      `Diagnosis` = condition,
      `Repeat Users` = 0,
      `Total Users` = 0,
      `Return Rate` = NA_real_,
      `Note` = "No data available."
    ))
  }
  
  data <- data %>%
    mutate(
      patient_key = if_else(is.na(patient_key), paste0("visit_", visit_id), patient_key),
      diagnosis_text = combined_diagnosis_text(.),
      chronic_exclusion = str_detect(diagnosis_text, non_return_chronic_regex)
    ) %>%
    filter(!chronic_exclusion)
  
  bind_rows(lapply(seq_len(nrow(conditions)), function(i) {
    condition_name <- conditions$condition[i]
    condition_key <- conditions$condition_key[i]
    condition_data <- data %>%
      filter(condition_match(., condition_key)) %>%
      filter(!is.na(patient_key), patient_key != "")
    
    denominator <- n_distinct(condition_data$patient_key)
    
    repeated_patients <- condition_data %>%
      arrange(patient_key, visit_date) %>%
      group_by(patient_key) %>%
      summarise(
        visits_with_condition = n_distinct(visit_id),
        shortest_span_days = ifelse(
          n_distinct(visit_id) >= 2,
          as.numeric(max(visit_date, na.rm = TRUE) - min(visit_date, na.rm = TRUE)),
          NA_real_
        ),
        has_repeat_flag = any(is_primary_dx_repeat_30d, na.rm = TRUE),
        .groups = "drop"
      ) %>%
      filter((visits_with_condition >= 2 & !is.na(shortest_span_days) & shortest_span_days <= 30) | has_repeat_flag)
    
    numerator <- nrow(repeated_patients)
    
    tibble(
      `Diagnosis` = condition_name,
      `Repeat Users` = numerator,
      `Total Users` = denominator,
      `Return Rate` = safe_pct(numerator, denominator),
      `Note` = ifelse(
        condition_key == "typhoid",
        "Typhoid symptoms/investigations are not yet fully configured in the system.",
        "Excludes chronic conditions where identifiable."
      )
    )
  }))
}

