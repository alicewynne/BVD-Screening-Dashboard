  })
  
  # County tables
  output$county_metric_table <- renderDT({
    table_data <- county_summary() %>%
      arrange(desc(total_visits)) %>%
      transmute(
        `State` = state, `County` = county, `Facilities Reporting` = total_facilities,
        `Total Visits` = total_visits, `Completed Visits` = completed_visits,
        `Overall Completion (%)` = completion_rate_pct, `Triage (%)` = triage_pct,
        `Symptoms (%)` = symptoms_pct, `Signs (%)` = signs_pct,
        `Impressions (%)` = impressions_pct, `Investigations (%)` = investigations_pct,
        `Diagnoses (%)` = diagnoses_pct, `Management (%)` = management_pct,
        `DCC Diagnosis Acceptance (%)` = dcc_diagnosis_acceptance_pct,
        `Guideline Compliance (%)` = guideline_compliance_pct,
