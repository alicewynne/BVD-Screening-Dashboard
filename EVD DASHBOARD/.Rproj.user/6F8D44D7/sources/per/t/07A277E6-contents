  })
  
  output$demographic_table <- renderDT({
    table_data <- county_summary() %>%
      transmute(
        `State` = state, `County` = county, `Total Visits` = total_visits,
        `Female Visits` = female_visits, `Female (%)` = female_pct,
        `Male Visits` = male_visits, `Male (%)` = male_pct,
        `Under 5 Visits` = under5_visits, `Under 5 (%)` = under5_pct,
