get_required_env <- function(variable_name) {
  value <- Sys.getenv(variable_name, unset = "")
  
  if (!nzchar(value)) {
    stop(
      paste0(
        "Missing required environment variable: ", variable_name,
        ". Add it to the local .env file or configure it in the hosting environment."
      ),
      call. = FALSE
    )
  }
  
  value
}

connect_db <- function() {
  db_port <- suppressWarnings(
    as.integer(get_required_env("DCC_DB_PORT"))
  )
  
  if (is.na(db_port)) {
    stop(
      "DCC_DB_PORT must be a valid whole number.",
      call. = FALSE
    )
  }
  
  db_connect_timeout <- suppressWarnings(
    as.integer(Sys.getenv("DCC_DB_CONNECT_TIMEOUT", unset = "10"))
  )
  if (is.na(db_connect_timeout) || db_connect_timeout < 1) {
    db_connect_timeout <- 10L
  }
  
  DBI::dbConnect(
    RPostgres::Postgres(),
    bigint = "numeric",
    host = get_required_env("DCC_DB_HOST"),
    port = db_port,
    dbname = get_required_env("DCC_DB_NAME"),
    user = get_required_env("DCC_DB_USER"),
    password = get_required_env("DCC_DB_PASSWORD"),
    sslmode = Sys.getenv("DCC_DB_SSLMODE", unset = "require"),
    connect_timeout = db_connect_timeout,
    application_name = "dcc_shiny_dashboard",
    timezone = Sys.getenv(
      "DCC_DB_TIMEZONE",
      unset = "Africa/Khartoum"
    )
  )
}


# Authenticate an Alert Management user against the approved email list.
# Passwords are read from .env and are never stored in this source file.
authenticate_alert_user <- function(email, password) {
  email_clean <- tolower(trimws(as.character(email)))
  password_value <- as.character(password)
  
  user_row <- authorized_alert_users %>%
    filter(email == email_clean)
  
  if (nrow(user_row) != 1) {
    return(list(ok = FALSE, message = "This email address is not authorized."))
  }
  
  expected_password <- Sys.getenv(user_row$password_env[1], unset = "")
  
  if (!nzchar(expected_password)) {
    return(list(
      ok = FALSE,
      message = paste0(
        "The password for this account has not been configured in .env (",
        user_row$password_env[1], ")."
      )
    ))
  }
  
  if (!nzchar(password_value) || !identical(password_value, expected_password)) {
    return(list(ok = FALSE, message = "Incorrect password."))
  }
  
  list(ok = TRUE, email = email_clean, message = "Access granted.")
}


