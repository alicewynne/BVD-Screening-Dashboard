        `Age 12 to 24 Visits` = age_12_24_visits, `Age 12 to 24 (%)` = age_12_24_pct,
        `Age 25 to 60 Visits` = age_25_60_visits, `Age 25 to 60 (%)` = age_25_60_pct,
        `Age 60 Plus Visits` = age_60_plus_visits, `Age 60 Plus (%)` = age_60_plus_pct
      )
    
    pct_cols <- c("Female (%)", "Male (%)", "Under 5 (%)", "Age 5 to 11 (%)", "Age 12 to 24 (%)", "Age 25 to 60 (%)", "Age 60 Plus (%)")
    
    datatable(table_data, rownames = FALSE, filter = "top", options = list(pageLength = 10, scrollX = TRUE, dom = "Bfrtip", buttons = c("copy", "csv", "excel")), extensions = "Buttons") %>%
      formatRound(columns = pct_cols, digits = 1)
  })
  # Keep hidden-tab outputs suspended so inactive pages do not keep recalculating
  # heavy plots/tables in the background.
  invisible(lapply(
    c(
      "facility_benchmark_plot", "selected_facility_week_plot", "main_metric_plot",
      "facility_metric_table", "sex_plot", "age_plot", "demographic_table",
      "facility_caseload_day_plot", "visit_step_time_plot", "top5_investigations_table", "top5_medications_table",
      "emergency_detection_table", "user_experience_table", "muac_demographic_plot",
      "history_taking_cards", "physical_exam_completeness_table", "follow_up_documentation_table", "medication_safety_table",
      "triage_component_plot", "triage_component_table", "county_metric_table", "indicator_table",
      "signal_top5_table", "clinical_case_classification_plot", "symptom_combination_table", "diagnosis_management_patterns_table",
      "diagnosis_return_rate_table", "condition_malaria_table", "condition_age_table", "condition_uti_table", "condition_typhoid_table",
      "public_health_condition_table", "new_30_day_table", "active_phe_signal_table", "alert_management_table", "alert_history_table"
