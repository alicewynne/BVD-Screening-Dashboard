      )
    
    high_good_cols <- c("Overall Completion (%)", "Triage (%)", "Symptoms (%)", "Signs (%)", "Impressions (%)", "Investigations (%)", "Diagnoses (%)", "Management (%)", "DCC Diagnosis Acceptance (%)", "Guideline Compliance (%)")
    low_good_cols <- "Diagnostic Variance (%)"
    
    datatable(table_data, rownames = FALSE, filter = "top", options = list(pageLength = 10, scrollX = TRUE, dom = "Bfrtip", buttons = c("copy", "csv", "excel")), extensions = "Buttons") %>%
      formatRound(columns = c(high_good_cols, low_good_cols), digits = 1) %>%
      formatStyle(columns = high_good_cols, backgroundColor = styleInterval(c(70, 90), c(metric_color_red, metric_color_amber, metric_color_green)), fontWeight = "bold") %>%
      formatStyle(columns = low_good_cols, backgroundColor = styleInterval(c(10, 30), c(metric_color_green, metric_color_amber, metric_color_red)), fontWeight = "bold")
  })
  
  output$indicator_table <- renderDT({
    table_data <- county_metric_long() %>%
      transmute(
        `State` = state, `County` = county, `Domain` = indicator_name,
        `Numerator Definition` = numerator_label,
        `Denominator Definition` = denominator_label,
        `Performance (%)` = indicator_value
      ) %>%
      arrange(`State`, `County`, `Domain`)
    
    datatable(table_data, rownames = FALSE, filter = "top", options = list(pageLength = 20, scrollX = TRUE, dom = "Bfrtip", buttons = c("copy", "csv", "excel")), extensions = "Buttons") %>%
      formatRound("Performance (%)", digits = 1)
  })
  
  # Facility table and triage components
  output$facility_metric_table <- renderDT({
    table_data <- facility_summary() %>%
      arrange(desc(total_visits)) %>%
      transmute(
        `Facility` = facility_group, `State` = state, `County` = county,
        `Total Visits` = total_visits, `Completed Visits` = completed_visits,
        `Overall Completion (%)` = completion_rate_pct, `Triage (%)` = triage_pct,
        `Symptoms (%)` = symptoms_pct, `Signs (%)` = signs_pct,
        `Impressions (%)` = impressions_pct, `Investigations (%)` = investigations_pct,
        `Diagnoses (%)` = diagnoses_pct, `Management (%)` = management_pct,
        `DCC Diagnosis Acceptance (%)` = dcc_diagnosis_acceptance_pct,
        `Guideline Compliance (%)` = guideline_compliance_pct,
        `Diagnostic Variance (%)` = diagnostic_variance_pct,
        `Female Visits` = female_visits, `Female (%)` = female_pct,
        `Male Visits` = male_visits, `Male (%)` = male_pct
      )
    
    high_good_cols <- c("Overall Completion (%)", "Triage (%)", "Symptoms (%)", "Signs (%)", "Impressions (%)", "Investigations (%)", "Diagnoses (%)", "Management (%)", "DCC Diagnosis Acceptance (%)", "Guideline Compliance (%)")
    low_good_cols <- "Diagnostic Variance (%)"
    pct_cols <- c(high_good_cols, low_good_cols, "Female (%)", "Male (%)")
    
    datatable(table_data, rownames = FALSE, filter = "top", options = list(pageLength = 15, scrollX = TRUE, dom = "Bfrtip", buttons = c("copy", "csv", "excel")), extensions = "Buttons") %>%
      formatRound(columns = pct_cols, digits = 1) %>%
      formatStyle(columns = high_good_cols, backgroundColor = styleInterval(c(70, 90), c(metric_color_red, metric_color_amber, metric_color_green)), fontWeight = "bold") %>%
      formatStyle(columns = low_good_cols, backgroundColor = styleInterval(c(10, 30), c(metric_color_green, metric_color_amber, metric_color_red)), fontWeight = "bold")
  })
  
  output$triage_component_plot <- renderPlotly({
    plot_data <- triage_component_summary() %>%
      mutate(
        component = factor(component, levels = c("Pulse", "BP Systolic", "BP Diastolic", "Respiratory Rate", "Temperature", "Weight", "MUAC")),
        label_position = pmin(completeness_pct + 2, 108),
        label = make_graph_label(completeness_pct, complete_n)
      )
    
    p <- ggplot(
      plot_data,
      aes(
        x = component, y = completeness_pct, fill = rag_status,
        text = paste0("Component: ", component, "<br>Complete: ", comma(complete_n), "<br>Total visits: ", comma(total_visits), "<br>Completeness: ", display_pct(completeness_pct))
      )
    ) +
      geom_col(width = 0.84, color = "white", linewidth = 0.6) +
      geom_text(
        aes(y = label_position, label = label),
        angle = 90, hjust = 0, vjust = 0.5, size = graph_data_label_size,
        fontface = "bold", color = who_dark_blue
      ) +
      scale_y_continuous(limits = c(0, 125), labels = percent_format(scale = 1)) +
      scale_fill_manual(values = rag_colors) +
      labs(x = NULL, y = "Completeness (%)", fill = "RAG Status") +
      theme_minimal(base_size = 13) +
      theme(legend.position = "bottom", axis.text.x = element_text(size = 10, face = "bold", angle = 25, hjust = 1), plot.margin = margin(10, 35, 10, 10))
    
    bold_plotly_data_labels(ggplotly(p, tooltip = "text")) %>%
      layout(margin = list(l = 60, r = 30, t = 20, b = 85), legend = list(orientation = "h", x = 0.15, y = -0.22)) %>%
      config(displayModeBar = FALSE)
  })
  
  output$triage_component_table <- renderDT({
    table_data <- triage_component_summary() %>%
      transmute(`Triage Component` = component, `Completed Records` = complete_n, `Total Visits` = total_visits, `Completeness (%)` = completeness_pct)
    
    datatable(table_data, rownames = FALSE, options = list(pageLength = 10, scrollX = TRUE, dom = "Bfrtip", buttons = c("copy", "csv", "excel")), extensions = "Buttons") %>%
      formatRound("Completeness (%)", digits = 1) %>%
      formatStyle("Completeness (%)", backgroundColor = styleInterval(c(70, 90), c(metric_color_red, metric_color_amber, metric_color_green)), fontWeight = "bold")
  })
  
  # Demographics
  output$sex_plot <- renderPlotly({
    sex_data <- overview_filtered_data() %>%
      count(gender, name = "visits") %>%
      mutate(
        percent = safe_pct(visits, sum(visits, na.rm = TRUE)),
        label = make_graph_label(percent, visits)
      )
    
    p <- ggplot(
      sex_data,
      aes(x = gender, y = visits, fill = gender, text = paste0(gender, ": ", comma(visits), " visits (", display_pct(percent), ")"))
    ) +
      geom_col(width = 0.82, color = "white", linewidth = 0.6) +
      geom_text(aes(label = label), vjust = -0.4, size = graph_data_label_size, fontface = "bold", color = who_dark_blue) +
      scale_fill_manual(values = sex_colors) +
      scale_y_continuous(labels = comma, expand = expansion(mult = c(0, 0.18))) +
      labs(x = NULL, y = "Visits") +
      theme_minimal(base_size = 13) +
      theme(legend.position = "none", axis.text.x = element_text(face = "bold"))
    
    bold_plotly_data_labels(ggplotly(p, tooltip = "text")) %>% layout(margin = list(l = 60, r = 30, t = 20, b = 60)) %>% config(displayModeBar = FALSE)
  })
  
  output$age_plot <- renderPlotly({
    age_levels <- c("Under 5", "5 to 11", "12 to 24", "25 to 60", "60 plus")
    age_data <- overview_filtered_data() %>%
      mutate(age_cohort = factor(age_cohort, levels = age_levels)) %>%
