# ============================================================
# 1A. LOAD LOCAL ENVIRONMENT VARIABLES
#
# Store database credentials in a local .env file in the same
# folder as app.R. The .env file must not be committed to GitHub.
# Existing operating-system or hosting-platform environment
# variables take precedence over values in the local .env file.
# ============================================================

load_dot_env <- function(path = ".env") {
  if (!file.exists(path)) {
    return(invisible(FALSE))
  }
  
  lines <- readLines(path, warn = FALSE, encoding = "UTF-8")
  lines <- sub("^[[:space:]]*export[[:space:]]+", "", lines)
  lines <- trimws(lines)
  lines <- lines[nzchar(lines) & !startsWith(lines, "#")]
  
  for (line in lines) {
    separator_position <- regexpr("=", line, fixed = TRUE)[1]
    
    if (separator_position <= 1) {
      next
    }
    
    key <- trimws(substr(line, 1, separator_position - 1))
    value <- trimws(substr(line, separator_position + 1, nchar(line)))
    
    if (
      nchar(value) >= 2 &&
      ((startsWith(value, '"') && endsWith(value, '"')) ||
       (startsWith(value, "'") && endsWith(value, "'")))
    ) {
      value <- substr(value, 2, nchar(value) - 1)
    }
    
    if (nzchar(key) && !nzchar(Sys.getenv(key, unset = ""))) {
      do.call(Sys.setenv, setNames(list(value), key))
    }
  }
  
  invisible(TRUE)
}

