  )
}

rag_status_high_good <- function(value) {
  case_when(
    is.na(value) ~ "No data",
    value >= 90 ~ "Green",
    value >= 70 ~ "Amber",
    TRUE ~ "Red"
  )
}

rag_status_low_good <- function(value) {
  case_when(
    is.na(value) ~ "No data",
    value <= 10 ~ "Green",
    value <= 30 ~ "Amber",
    TRUE ~ "Red"
  )
}

