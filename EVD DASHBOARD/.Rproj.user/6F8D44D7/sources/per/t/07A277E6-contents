parse_jsonish_items <- function(x, preferred_fields = character()) {
  x <- clean_optional_text(x)
  x <- x[!is.na(x)]
  
  if (length(x) == 0) {
    return(character())
  }
  
  collect_atomic_values <- function(obj, preferred_fields = character()) {
    out <- character()
    walk <- function(value, field_name = "") {
      if (is.null(value)) {
        return(invisible(NULL))
      }
      if (is.atomic(value) && length(value) > 0) {
        # The DCC prescribed-medication field is commonly a top-level JSON
        # array of drug-name strings. Empty field_name therefore represents a
        # legitimate root-list value, while named object fields are restricted
        # to the requested clinical keys.
        field_match <- length(preferred_fields) == 0 ||
          field_name == "" ||
          tolower(field_name) %in% tolower(preferred_fields)
        if (field_match) {
          out <<- c(out, as.character(value))
        }
        return(invisible(NULL))
      }
      if (is.list(value)) {
        names_value <- names(value)
        for (j in seq_along(value)) {
          child_name <- if (!is.null(names_value) && nzchar(names_value[j])) names_value[j] else field_name
          walk(value[[j]], child_name)
        }
      }
      invisible(NULL)
    }
    walk(obj)
    out
  }
  
  rows <- lapply(x, function(one_text) {
    parsed_items <- character()
    json_candidate <- trimws(as.character(one_text))
    if (str_detect(json_candidate, "^[\\[{]")) {
      parsed <- tryCatch(
        jsonlite::fromJSON(json_candidate, simplifyVector = FALSE),
        error = function(e) NULL
      )
      if (!is.null(parsed)) {
        parsed_items <- collect_atomic_values(parsed, preferred_fields)
      }
    }
    
    if (length(parsed_items) == 0) {
      parsed_items <- unlist(str_split(one_text, "\\s*[;|]\\s*"), use.names = FALSE)
      parsed_items <- unlist(str_split(parsed_items, "\\s*,\\s*"), use.names = FALSE)
      parsed_items <- str_replace_all(parsed_items, "[\\[\\]{}\"]", " ")
      parsed_items <- str_replace_all(
        parsed_items,
        "\\b(code|name|label|title|drug|medication|investigation|text|value|display|dosage|dose|route|frequency|max)\\b\\s*:",
        " "
      )
    }
    parsed_items
  })
  
  items <- unlist(rows, use.names = FALSE)
  items <- str_replace_all(items, "\\s+", " ")
  items <- str_squish(items)
  items <- items[!is.na(items) & items != ""]
  items <- items[!str_detect(str_to_lower(items), "^(null|none|na|true|false|yes|no)$")]
  items <- items[!str_detect(str_to_lower(items), "^\\[?object object\\]?$|object object")]
  unique(str_to_title(items))
}

clean_medication_items <- function(items) {
  if (length(items) == 0) {
    return(character())
  }
  items <- str_squish(as.character(items))
  items <- items[!is.na(items) & items != ""]
  
  extract_one_item <- function(one_item) {
    one_item <- str_squish(one_item)
    item_lower <- str_to_lower(one_item)
    item_lower <- str_replace_all(item_lower, "\\s+", " ")
    
    # These values are embedded guideline controls or instructions in the JSON
    # array, not prescribed medicines.
    pure_metadata <- str_detect(
      item_lower,
      paste(
        c(
          "^(first|second|third|add|remove)$",
          "^(first|second|third) choice:?$",
          "^(uncomplicated|severe) malaria (first|second) choice:?$",
          "^severe malaria alternative:?$",
          "^(hypoglycaemia|hypoglycemia|convulsion|transfusion|bleeding) .*management:?$",
          "^max(?:imum)?\\s*[0-9]", "^(child|adult|toddler|infant|neonate)\\s*[:(]",
          "^weight$", "^maintenance per response$", "^is preferred if",
          "^if\\b", "^then\\b", "^treat all\\b", "^follow up\\b",
          "^screen for\\b", "^assess for\\b", "^refer\\b", "^give fluid\\b",
          "^(no|some) dehydration", "^persistent diarrh", "^dysentery:?$",
          "^outpatient treatment$", "^women using"
        ),
        collapse = "|"
      )
    )
    if (pure_metadata) return(character())
    
    drugs <- character()
    add_drug <- function(pattern, label) {
      if (str_detect(item_lower, pattern)) drugs <<- c(drugs, label)
    }
    
    asaq_combo <- str_detect(
      item_lower,
      "artesunate\\s*\\+?\\s*amodiaquine|asa/q|as\\s*/\\s*aq|\\basaq\\b"
    )
    if (asaq_combo) {
      drugs <- c(drugs, "Artesunate + Amodiaquine (ASAQ)")
    } else {
      add_drug("\\bartesunate\\b", "Artesunate")
    }
    add_drug("\\bamox(?:icillin|ycillin)?\\b|amoxycillin", "Amoxicillin")
    add_drug("\\bceftriaxone\\b|\\bceft\\b", "Ceftriaxone")
    add_drug("\\bmetronidazole\\b|\\bmetro\\b", "Metronidazole")
    add_drug("\\bparacetamol\\b|\\bacetaminophen\\b|\\bpct\\b", "Paracetamol")
    add_drug("\\bibuprofen\\b|\\bibrufen\\b|\\bibupro\\b", "Ibuprofen")
    add_drug("oral rehydration salts|\\bors\\b", "Oral Rehydration Salts (ORS)")
    add_drug("\\bzinc(?: sulphate| sulfate)?\\b", "Zinc Sulphate")
    add_drug("\\bciprofloxacin\\b", "Ciprofloxacin")
    add_drug("\\bcloxacillin\\b", "Cloxacillin")
    add_drug("\\bcefalexin\\b|\\bcephalexin\\b", "Cefalexin")
    add_drug("\\bdoxycycline\\b", "Doxycycline")
    add_drug("\\berythromycin\\b", "Erythromycin")
    add_drug("\\bazithromycin\\b", "Azithromycin")
    add_drug("\\bferrous(?: sulphate| sulfate)?\\b", "Ferrous Sulphate")
    add_drug("\\bomeprazole\\b", "Omeprazole")
    add_drug("\\bamlodipine\\b", "Amlodipine")
    add_drug("\\bampicillin\\b", "Ampicillin")
    add_drug("\\bbenzyl penicillin\\b", "Benzyl Penicillin")
    add_drug("\\bcoartem\\b|artemether[ -]?lumefantrine|^act$", "Artemether-Lumefantrine (ACT)")
    add_drug("\\baspirin\\b|\\basprin\\b", "Aspirin")
    
    if (length(drugs) > 0) return(unique(drugs))
    
    # Preserve concise free-text medicine names that are not yet in the
    # canonical dictionary, but reject numeric dosing schedules and prose.
    fallback_is_drug <- str_count(item_lower, "\\S+") <= 5 &&
      str_detect(item_lower, "[[:alpha:]]") &&
      !str_detect(
        item_lower,
        paste(
          c(
            "[0-9]", "\\b(mg|mcg|g|kg|ml|iu)\\b", "\\b(po|iv|im|sc)\\b",
            "\\b(bd|od|tds|qid|qds|prn|stat)\\b", "\\b(days?|hours?|weeks?)\\b",
            "\\b(tablet|tablets|tab|tabs|capsule|capsules|cap|caps|syrup|injection)\\b",
            "\\b(choice|management|guideline|protocol|dose|route|frequency|duration)\\b"
          ),
          collapse = "|"
        )
      )
    
    if (!fallback_is_drug) return(character())
    str_to_title(one_item)
  }
  
  drugs <- unlist(lapply(items, extract_one_item), use.names = FALSE)
  drugs <- clean_optional_text(drugs)
  unique(drugs[!is.na(drugs) & drugs != ""])
}

