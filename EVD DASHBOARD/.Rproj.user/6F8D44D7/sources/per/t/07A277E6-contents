make_medication_safety_summary <- function(data) {
  pediatric_flag <- data$is_muac_cohort_pediatric |
    (!is.na(data$patient_age) & data$patient_age < 18)
  pediatric_denom <- sum(pediatric_flag, na.rm = TRUE)
  medication_denom <- sum(data$has_medication_prescribed | data$medication_count > 0, na.rm = TRUE)
  poly_numerator <- sum(data$is_polypharmacy | data$medication_count >= 4, na.rm = TRUE)
  
  bind_rows(
    clean_rate_row("Dose Verification (age and weight)", sum(data$is_pediatric_weight_documented | (pediatric_flag & data$weight_filled), na.rm = TRUE), pediatric_denom, "Users below 18 years with weight documented in triage", "Users below 18 years"),
    clean_rate_row("Polypharmacy Rate", poly_numerator, medication_denom, "Visits where four or more medications were prescribed", "Visits where medication was prescribed")
  )
}


make_public_health_condition_summary <- function(data, workflow_data = NULL) {
  if (nrow(data) == 0) {
    return(tibble(condition = character(), cases = integer()))
  }
  
  make_phe_alert_rows(data) %>%
    attach_alert_workflow(workflow_data) %>%
    filter(!status %in% c("cleared", "discarded")) %>%
    group_by(diagnosis_key) %>%
    summarise(
      condition = first(diagnosis_label),
      cases = n_distinct(alert_key),
      .groups = "drop"
    ) %>%
    arrange(desc(cases), condition) %>%
    select(condition, cases)
}

make_new_30_day_summary <- function(data) {
  bounds <- latest_week_bounds(data)
  
  if (is.na(bounds$anchor)) {
    return(tibble(
      diagnosis_code = character(),
      diagnosis_label = character(),
      diagnosis_key = character(),
      cases = integer()
    ))
  }
  
  current_diagnoses <- data %>%
    filter(
      visit_date >= bounds$current_start,
      visit_date <= bounds$current_end
    ) %>%
    make_diagnosis_long()
  
  prior_30_day_diagnoses <- data %>%
    filter(
      visit_date >= bounds$reference_30_start,
      visit_date <= bounds$reference_30_end
    ) %>%
    make_diagnosis_long()
  
  prior_keys <- unique(prior_30_day_diagnoses$diagnosis_key)
  
  current_diagnoses %>%
    filter(!diagnosis_key %in% prior_keys) %>%
    group_by(diagnosis_key) %>%
    summarise(
      diagnosis_code = paste(
        sort(unique(na.omit(diagnosis_code))),
        collapse = ", "
      ),
      diagnosis_label = first(diagnosis_label),
      cases = n_distinct(visit_id),
      .groups = "drop"
    ) %>%
    mutate(
      diagnosis_code = if_else(diagnosis_code == "", NA_character_, diagnosis_code)
    ) %>%
    arrange(desc(cases), diagnosis_label)
}

summarise_phe_alert_rows <- function(phe_alerts) {
  if (is.null(phe_alerts) || nrow(phe_alerts) == 0) {
    return(tibble(
      possible_phe_signals = 0,
      pending_review = 0,
      isolate_now = 0,
      health_alert_visits = 0,
      total_health_alerts = 0,
      facilities_with_phe = 0,
      facilities_with_alerts = 0,
      facility_names = "",
      latest_signal_date = as.Date(NA),
      alert_level = "clear",
      active_alert_flag = FALSE,
      active_red_flag = FALSE
    ))
  }
  
  active_alerts <- phe_alerts %>%
    filter(status %in% c("open", "follow_up"))
  
  possible_phe_signals <- n_distinct(active_alerts$alert_key)
  pending_review <- n_distinct(
    active_alerts$alert_key[active_alerts$status == "follow_up"]
  )
  
  # These fields are not currently available in the source view.
  isolate_now <- 0
  health_alert_visits <- 0
  total_health_alerts <- 0
  
  signal_dates <- active_alerts$alert_date[!is.na(active_alerts$alert_date)]
  alert_level <- ifelse(possible_phe_signals > 0, "critical", "clear")
  
  tibble(
    possible_phe_signals = possible_phe_signals,
    pending_review = pending_review,
    isolate_now = isolate_now,
    health_alert_visits = health_alert_visits,
    total_health_alerts = total_health_alerts,
    facilities_with_phe = n_distinct(active_alerts$facility_group),
    facilities_with_alerts = n_distinct(active_alerts$facility_group),
    facility_names = paste(
      sort(unique(active_alerts$facility_group)),
      collapse = ", "
    ),
    latest_signal_date = if (length(signal_dates) == 0) {
      as.Date(NA)
    } else {
      max(signal_dates)
    },
    alert_level = alert_level,
    active_alert_flag = alert_level != "clear",
    active_red_flag = alert_level == "critical"
  )
}

make_public_health_signal_summary <- function(data, workflow_data = NULL) {
  phe_alerts <- make_phe_alert_rows(data) %>%
    attach_alert_workflow(workflow_data)
  
  summarise_phe_alert_rows(phe_alerts)
}


make_alert_banner <- function(summary_data, overview = FALSE) {
  level <- summary_data$alert_level[1]
  latest_date_text <- ifelse(
    is.na(summary_data$latest_signal_date[1]),
    "date unavailable",
    format(summary_data$latest_signal_date[1], "%d %b %Y")
  )
  facility_text <- ifelse(
    is.na(summary_data$facility_names[1]) |
      summary_data$facility_names[1] == "",
    "",
    paste0(" at ", summary_data$facility_names[1])
  )
  detail_suffix <- " Open Alert Management for review and follow-up."
  
  if (identical(level, "critical")) {
    return(
      tags$div(
        class = "phe-alert-banner phe-alert-critical",
        icon("exclamation-triangle"),
        HTML(
          paste0(
            "&nbsp;PUBLIC HEALTH EMERGENCY ALERT: ",
            comma(summary_data$possible_phe_signals[1]),
            " active PHE signal(s)",
            facility_text,
            ". Latest signal: ", latest_date_text, ".",
            detail_suffix
          )
        )
      )
    )
  }
  
  tags$div(
    class = "phe-alert-banner phe-alert-clear",
    icon("check-circle"),
    HTML(
      "&nbsp;PUBLIC HEALTH EMERGENCY STATUS IS CLEAR: No active PHE signal is currently detected in the selected period."
    )
  )
}

make_latest_week_caption <- function(data, scope_label) {
  bounds <- latest_week_bounds(data)
  
  if (is.na(bounds$anchor)) {
    return(paste0(scope_label, " \u2022 No diagnosis data available"))
  }
  
  current_visits <- data %>%
    filter(
      visit_date >= bounds$current_start,
      visit_date <= bounds$current_end
    ) %>%
    summarise(total = n_distinct(visit_id)) %>%
    pull(total)
  
  paste0(
    scope_label,
    " \u2022 ",
    format(bounds$current_start, "%d %b %Y"),
    " to ",
    format(bounds$current_end, "%d %b %Y"),
    " \u2022 ",
    comma(current_visits),
    " consultations"
  )
}


