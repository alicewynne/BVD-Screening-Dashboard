make_emergency_detection_summary <- function(data) {
  capture_available <- any(
    data$is_emergency_patient_available &
      data$is_early_emergency_captured_available,
    na.rm = TRUE
  )
  false_alarm_available <- any(
    data$is_early_emergency_flagged_available &
      data$is_early_emergency_false_alarm_available,
    na.rm = TRUE
  )
  action_time_available <- any(
    data$is_early_emergency_flagged_available &
      data$flag_to_action_minutes_available,
    na.rm = TRUE
  )
  
  if (!capture_available && !false_alarm_available && !action_time_available) {
    return(tibble(
      metric = c(
        "Early Emergency Capture Rate",
        "False Alarm Rate",
        "Flag to Action Time"
      ),
      numerator_definition = c(
        "Emergency patients flagged at registration or triage",
        "Early flagged patients who were not emergencies",
        "Median minutes from the first early flag to management or referral"
      ),
      numerator = NA_real_,
      denominator_definition = c(
        "All emergency patients",
        "All early flagged patients",
        "Early flagged patients with a valid action time"
      ),
      denominator = NA_real_,
      percent = NA_real_,
      value = NA_real_,
      unit = c("percent", "percent", "minutes"),
      note = "Emergency metric fields are not available in v_dcc_visits."
    ))
  }
  
  emergency_n <- if (capture_available) sum(data$is_emergency_patient, na.rm = TRUE) else NA_real_
  captured_n <- if (capture_available) sum(data$early_emergency_captured_flag, na.rm = TRUE) else NA_real_
  flagged_n <- if (false_alarm_available) sum(data$early_emergency_flagged_flag, na.rm = TRUE) else NA_real_
  false_alarm_n <- if (false_alarm_available) sum(data$early_emergency_false_alarm_flag, na.rm = TRUE) else NA_real_
  valid_action_times <- if (action_time_available) {
    valid_flag_to_action <- valid_operational_minutes(data$flag_to_action_minutes)
    valid_flag_to_action[
      data$early_emergency_flagged_flag &
        !is.na(valid_flag_to_action)
    ]
  } else {
    numeric()
  }
  action_records <- if (action_time_available) length(valid_action_times) else NA_real_
  median_action_minutes <- if (!action_time_available || length(valid_action_times) == 0) {
    NA_real_
  } else {
    round(stats::median(valid_action_times, na.rm = TRUE), 1)
  }
  
  tibble(
    metric = c(
      "Early Emergency Capture Rate",
      "False Alarm Rate",
      "Flag to Action Time"
    ),
    numerator_definition = c(
      "Emergency patients flagged at registration or triage",
      "Early flagged patients who were not emergencies",
      "Median minutes from the first early flag to management or referral"
    ),
    numerator = c(captured_n, false_alarm_n, median_action_minutes),
    denominator_definition = c(
      "All emergency patients",
      "All early flagged patients",
      "Early flagged patients with a valid action time"
    ),
    denominator = c(emergency_n, flagged_n, action_records),
    percent = c(
      safe_pct(captured_n, emergency_n),
      safe_pct(false_alarm_n, flagged_n),
      NA_real_
    ),
    value = c(
      safe_pct(captured_n, emergency_n),
      safe_pct(false_alarm_n, flagged_n),
      median_action_minutes
    ),
    unit = c("percent", "percent", "minutes"),
    note = c(
      ifelse(
        capture_available,
        "Uses is_early_emergency_captured among is_emergency_patient records.",
        "Required emergency-patient or captured flag is not available."
      ),
      ifelse(
        false_alarm_available,
        "Uses is_early_emergency_false_alarm among is_early_emergency_flagged records.",
        "Required early-flag or false-alarm flag is not available."
      ),
      ifelse(
        action_time_available,
        "Uses flag_to_action_minutes among early flagged patients; valid operational intervals are 0–1440 minutes.",
        "Required early-flag or flag-to-action field is not available."
      )
    )
  )
}

