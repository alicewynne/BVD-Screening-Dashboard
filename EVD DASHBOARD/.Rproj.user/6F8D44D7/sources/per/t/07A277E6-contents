  observeEvent(input$save_alert_update, {
    req(isTRUE(alert_logged_in()))
    alert <- selected_alert()
    req(!is.null(alert), nrow(alert) == 1)
    
    new_status <- input$alert_action_choice
    assigned_to <- trimws(as.character(input$alert_assigned_to))
    note <- trimws(as.character(input$alert_follow_up_note))
    
    if (is.null(new_status) || !new_status %in% c("open", "follow_up", "cleared", "discarded")) {
      showNotification(
        "Select one action: approve for follow-up, clear, discard, or keep open.",
        type = "error",
        duration = 7
      )
      return()
    }
    
    if (!isTRUE(input$confirm_alert_action)) {
      showNotification(
        "Tick the confirmation box before applying the action.",
        type = "error",
        duration = 7
      )
      return()
    }
    
    if (!nzchar(note)) {
      showNotification(
        "Record an action, follow-up, clearance or discard note before saving.",
        type = "error",
        duration = 7
      )
      return()
    }
    
    if (identical(new_status, "follow_up") && !nzchar(assigned_to)) {
      showNotification(
        "Enter the assigned officer or official email before approving follow-up.",
        type = "error",
        duration = 7
      )
      return()
    }
    
    tryCatch(
      {
        # Ensure a live banner signal has a persistent workflow record before
        # its action is saved. This also covers signals not previously synced.
        sync_phe_alert_records(national_date_filtered_data())
        
        update_phe_alert_status(
          alert_key = alert$alert_key[1],
          new_status = new_status,
          assigned_to = assigned_to,
          note = note,
          changed_by = alert_current_user()
        )
        
        alert_workflow_store(fetch_phe_alert_workflow())
        alert_workflow_version(isolate(alert_workflow_version()) + 1L)
        DT::selectRows(DT::dataTableProxy("active_phe_signal_table"), NULL)
        DT::selectRows(DT::dataTableProxy("alert_management_table"), NULL)
        updateCheckboxInput(session, "confirm_alert_action", value = FALSE)
        updateRadioButtons(session, "alert_action_choice", selected = character(0))
        
        action_message <- switch(
          new_status,
          follow_up = "The PHE signal was approved for follow-up.",
          cleared = "Follow-up was completed and the PHE signal was cleared. It remains in the audit register and no longer activates the blinking alert.",
          discarded = "The PHE signal was discarded as non-PHE. It remains in the audit register and no longer activates the blinking alert.",
          open = "The PHE signal remains open for further review.",
          "The PHE signal was updated."
        )
        
        showNotification(
          action_message,
          type = "message",
          duration = 8
        )
      },
      error = function(e) {
        showNotification(
          paste("Alert action failed:", e$message),
          type = "error",
          duration = 12
        )
      }
    )
  })
  
