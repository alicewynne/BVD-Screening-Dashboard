    presumed_cases <- n_distinct(data$visit_id[definitive_flag & !test_ordered_flag])
    confirmed_cases <- n_distinct(data$visit_id[definitive_flag & confirmed_flag])
    managed_firstline <- n_distinct(data$visit_id[definitive_flag & data$treatment_guideline_adherent_flag])
    
