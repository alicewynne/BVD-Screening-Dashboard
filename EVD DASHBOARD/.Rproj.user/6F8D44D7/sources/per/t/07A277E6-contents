make_mortality_metric_summary <- function(data) {
  count_flag <- function(x) {
    sum(x %in% TRUE, na.rm = TRUE)
  }
  
  malaria_numerator_flags <- data$is_malaria_death_proxy |
    data$malaria_cfr_numerator_eligible
  
  malaria_denominator_flags <- data$malaria_cfr_denominator_eligible |
    data$is_confirmed_malaria
  
  malaria_deaths <- count_flag(malaria_numerator_flags)
  malaria_cases <- count_flag(malaria_denominator_flags)
  
  cap_deaths <- count_flag(data$is_cap_death_proxy)
  cap_cases <- count_flag(data$is_confirmed_cap)
  
  maternal_deaths <- count_flag(data$is_maternal_death_proxy)
  
  tibble(
    indicator = c(
      "Malaria Case Fatality Rate",
      "Community Acquired Pneumonia Fatality Rate",
      "Maternal Mortality Rate"
    ),
    numerator_definition = c(
      "Number of deaths due to malaria",
      "Number of deaths due to community acquired pneumonia",
      "Number of maternal deaths"
    ),
    numerator = c(
      malaria_deaths,
      cap_deaths,
      maternal_deaths
    ),
    denominator_definition = c(
      "Total confirmed malaria cases",
      "Total confirmed community acquired pneumonia cases",
      "Number of live births"
    ),
    denominator = c(
      malaria_cases,
      cap_cases,
      NA_real_
    ),
    value = c(
      safe_pct(malaria_deaths, malaria_cases),
      safe_pct(cap_deaths, cap_cases),
      NA_real_
    ),
    data_availability = c(
      ifelse(malaria_cases > 0, "Available from current proxy fields", "No confirmed malaria denominator records in current filters"),
      ifelse(cap_cases > 0, "Available from current proxy fields", "No confirmed pneumonia denominator records in current filters"),
      "Not available: live births denominator is not available in v_dcc_visits"
    )
  )
}

