# Console-only diagnostic for Maiwut. This does not change any dashboard tab,
# visual, indicator, table, or calculation. It prints why Maiwut would become
# zero after source, latest-device, date, and cleaned-facility filters.
diagnose_maiwut_data_path <- function(cleaned_data = NULL) {
  tryCatch(
    {
      con <- connect_db()
      on.exit(DBI::dbDisconnect(con), add = TRUE)
      diagnostic_summary <- DBI::dbGetQuery(
        con,
        "
        WITH raw AS (
          SELECT
            device_id::text AS device_id,
            backup_source::text AS backup_source,
            patient_hospital::text AS patient_hospital,
            patient_state::text AS patient_state,
            patient_county::text AS patient_county,
            is_latest_for_device,
            visit_created_at::text AS visit_created_at
          FROM v_dcc_visits
          WHERE lower(coalesce(device_id, '')) LIKE '%maiwut%'
             OR lower(coalesce(device_id, '')) LIKE '%upnmampma%'
             OR lower(coalesce(backup_source, '')) LIKE '%maiwut%'
             OR lower(coalesce(backup_source, '')) LIKE '%upnmampma%'
             OR lower(coalesce(patient_hospital, '')) LIKE '%maiwut%'
             OR lower(coalesce(patient_county, '')) LIKE '%maiwut%'
        )
        SELECT
          COUNT(*) AS raw_maiwut_candidates,
          COUNT(*) FILTER (WHERE is_latest_for_device = TRUE) AS latest_true_candidates,
          COUNT(*) FILTER (WHERE visit_created_at IS NOT NULL) AS non_missing_visit_created_at,
          MIN(visit_created_at) AS earliest_visit_created_at,
          MAX(visit_created_at) AS latest_visit_created_at
        FROM raw
        "
      )
      diagnostic_sources <- DBI::dbGetQuery(
        con,
        "
        SELECT
          device_id::text AS device_id,
          backup_source::text AS backup_source,
          patient_hospital::text AS patient_hospital,
          patient_state::text AS patient_state,
          patient_county::text AS patient_county,
          COUNT(*) AS records,
          MIN(visit_created_at)::text AS first_visit,
          MAX(visit_created_at)::text AS last_visit
        FROM v_dcc_visits
        WHERE lower(coalesce(device_id, '')) LIKE '%maiwut%'
           OR lower(coalesce(device_id, '')) LIKE '%upnmampma%'
           OR lower(coalesce(backup_source, '')) LIKE '%maiwut%'
           OR lower(coalesce(backup_source, '')) LIKE '%upnmampma%'
           OR lower(coalesce(patient_hospital, '')) LIKE '%maiwut%'
           OR lower(coalesce(patient_county, '')) LIKE '%maiwut%'
        GROUP BY device_id, backup_source, patient_hospital, patient_state, patient_county
        ORDER BY records DESC
        LIMIT 12
        "
      )
      message("============================================================")
      message("MAIWUT DATA DIAGNOSTIC")
      message("Raw Maiwut/UPNMAMPMA candidates in v_dcc_visits: ", diagnostic_summary$raw_maiwut_candidates[1])
      message("Maiwut candidates with is_latest_for_device = TRUE: ", diagnostic_summary$latest_true_candidates[1])
      message("Maiwut candidates with non-missing visit_created_at: ", diagnostic_summary$non_missing_visit_created_at[1])
      message("Maiwut source date range: ", diagnostic_summary$earliest_visit_created_at[1], " to ", diagnostic_summary$latest_visit_created_at[1])
      if (!is.null(cleaned_data)) {
        cleaned_maiwut <- cleaned_data %>% filter(facility_group == "Maiwut")
        message("Maiwut rows retained after dashboard cleaning: ", nrow(cleaned_maiwut))
        if (nrow(cleaned_maiwut) > 0) {
          message("Maiwut cleaned date range: ", min(cleaned_maiwut$visit_date, na.rm = TRUE), " to ", max(cleaned_maiwut$visit_date, na.rm = TRUE))
          message("Maiwut state/county retained: ", paste(sort(unique(paste(cleaned_maiwut$state, cleaned_maiwut$county, sep = " / "))), collapse = "; "))
        }
      }
      message("Maiwut source groups:")
      utils::capture.output(print(diagnostic_sources)) %>% paste(collapse = "\n") %>% message()
      message("============================================================")
    },
    error = function(e) {
      message("MAIWUT DATA DIAGNOSTIC could not run: ", e$message)
    }
  )
  invisible(TRUE)
}

