clean_optional_text <- function(x) {
  x <- str_squish(as.character(x))
  x[x %in% c("", "NA", "NaN", "NULL", "null", "None", "none")] <- NA_character_
  x
}

# Repairs the common UTF-8 dash encoding seen in database exports and
# normalizes the text before diagnoses are separated.
repair_diagnosis_text <- function(x) {
  x <- clean_optional_text(x)
  x <- str_replace_all(x, fixed("â€”"), "—")
  x <- str_replace_all(x, fixed("â€“"), "–")
  x <- str_replace_all(x, "\\s*;\\s*", "; ")
  str_squish(x)
}

# The DCC source currently contains several malaria labels/codes, including
# 1F40-1F49 and 1F4Z. For morbidity and clinical-signal reporting they all
# represent the same indicator and must be reported under one canonical ICD-11
# label: 1F4Z — Malaria. Normalisation is applied to each semicolon-separated
# diagnosis without changing other diagnoses recorded in the same visit.
is_malaria_diagnosis_text <- function(x) {
  x_clean <- repair_diagnosis_text(x) %>%
    str_to_lower()
  !is.na(x_clean) & str_detect(
    x_clean,
    "(^|[^[:alnum:]])1f4[[:alnum:]]*|\\bmalaria\\b|\\bplasmod"
  )
}

normalize_malaria_diagnosis_text <- function(x) {
  x <- repair_diagnosis_text(x)
  vapply(
    x,
    function(one_value) {
      if (is.na(one_value) || !nzchar(one_value)) return(NA_character_)
      diagnosis_items <- str_split(one_value, "\\s*;\\s*")[[1]] %>%
        str_squish()
      diagnosis_items <- if_else(
        is_malaria_diagnosis_text(diagnosis_items),
        "1F4Z — Malaria",
        diagnosis_items
      )
      diagnosis_items <- unique(diagnosis_items[!is.na(diagnosis_items) & diagnosis_items != ""])
      if (length(diagnosis_items) == 0) NA_character_ else paste(diagnosis_items, collapse = "; ")
    },
    character(1)
  )
}

extract_primary_icd_code <- function(x) {
  x <- repair_diagnosis_text(x)
  code <- str_extract(
    x,
    "^[[:alnum:]][[:alnum:].-]*(?:\\s*,\\s*[[:alnum:]][[:alnum:].-]*)*"
  )
  clean_optional_text(str_to_upper(code))
}

strip_primary_icd_code <- function(x) {
  x <- repair_diagnosis_text(x)
  # Some view fields already contain the code and older transformations may
  # have prefixed it more than once (for example "CA40 — CA40 — Pneumonia").
  # Remove up to three repeated leading ICD-code prefixes, while preserving
  # hyphens that are part of the clinical description itself.
  label <- x
  for (strip_index in seq_len(3)) {
    label <- str_replace(
      label,
      "^[[:alnum:]][[:alnum:].-]*(?:\\s*,\\s*[[:alnum:]][[:alnum:].-]*)*\\s+[—–-]\\s+",
      ""
    )
  }
  clean_optional_text(label)
}

normalize_primary_icd_code <- function(code, diagnosis_text = NA_character_) {
  code <- clean_optional_text(str_to_upper(code))
  diagnosis_text <- repair_diagnosis_text(diagnosis_text)
  malaria <- is_malaria_diagnosis_text(
    paste(coalesce(code, ""), coalesce(diagnosis_text, ""))
  )
  if_else(malaria, "1F4Z", code)
}

normalize_primary_diagnosis_label <- function(label, code = NA_character_) {
  label <- strip_primary_icd_code(label)
  malaria <- is_malaria_diagnosis_text(
    paste(coalesce(code, ""), coalesce(label, ""))
  )
  label <- if_else(malaria, "Malaria", label)
  clean_optional_text(label)
}

# All dashboard-facing diagnosis names must be plain clinical descriptions.
# ICD codes remain available internally for database logic only and are never
# returned by this helper. Malaria is always displayed as one word: Malaria.
diagnosis_name_for_display <- function(x) {
  x <- normalize_malaria_diagnosis_text(x)
  vapply(
    x,
    function(one_value) {
      if (is.na(one_value) || !nzchar(one_value)) return(NA_character_)
      first_item <- str_split(one_value, "\\s*;\\s*")[[1]][1] %>% str_squish()
      if (is_malaria_diagnosis_text(first_item)) return("Malaria")
      clean_name <- strip_primary_icd_code(first_item)
      if (is.na(clean_name) || !nzchar(clean_name)) NA_character_ else clean_name
    },
    character(1)
  )
}

# Acute watery diarrhoea is deliberately excluded from PHE detection.
# The final diagnosis may use British spelling, American spelling, or an
# underscore-separated value. Cholera itself is not excluded.
is_acute_watery_diarrhoea <- function(x) {
  x_clean <- str_to_lower(str_squish(as.character(x)))
  x_clean <- str_replace_all(x_clean, "_", " ")
  x_clean <- str_replace_all(x_clean, "-", " ")
  x_clean <- str_squish(x_clean)
  
  !is.na(x_clean) & str_detect(
    x_clean,
    "acute watery diarrh(oea|ea)|watery diarrh(oea|ea)"
  )
}

# Returns TRUE when a diagnosis description matches the configurable PHE list.
# watery_diarrhea by itself is never treated as a qualifying PHE diagnosis.
is_phe_diagnosis <- function(x) {
  diagnosis_text <- str_to_lower(str_squish(as.character(x)))
  diagnosis_text <- str_replace_all(diagnosis_text, "_", " ")
  
  phe_regex <- paste(phe_diagnosis_patterns, collapse = "|")
  matched_phe <- !is.na(diagnosis_text) & str_detect(diagnosis_text, phe_regex)
  watery_only <- is_acute_watery_diarrhoea(diagnosis_text) & !matched_phe
  
  matched_phe & !watery_only
}

# Converts final_diagnosis into one diagnosis per row. The database field is
# split only on semicolons because commas may occur inside ICD codes or labels.
make_diagnosis_long <- function(data) {
  required_columns <- c(
    "visit_id", "visit_date", "facility_group", "state", "county",
    "final_diagnosis"
  )
  
  if (nrow(data) == 0 || !all(required_columns %in% names(data))) {
    return(tibble(
      visit_id = numeric(),
      visit_date = as.Date(character()),
      facility_group = character(),
      state = character(),
      county = character(),
      diagnosis_code = character(),
      diagnosis_label = character(),
      diagnosis_key = character(),
      is_phe = logical()
    ))
  }
  
  diagnosis_rows <- data %>%
    transmute(
      visit_id,
      visit_date,
      facility_group,
      state,
      county,
      diagnosis_item = normalize_malaria_diagnosis_text(final_diagnosis)
    ) %>%
    filter(!is.na(diagnosis_item)) %>%
    separate_rows(diagnosis_item, sep = "\\s*;\\s*") %>%
    mutate(
      diagnosis_item = str_squish(diagnosis_item),
      diagnosis_item = if_else(
        is_malaria_diagnosis_text(diagnosis_item),
        "1F4Z — Malaria",
        diagnosis_item
      ),
      diagnosis_item = str_replace_all(diagnosis_item, fixed("â€”"), "—"),
      diagnosis_item = str_replace_all(diagnosis_item, fixed("â€“"), "–"),
      has_code_separator = str_detect(
        diagnosis_item,
        "^[[:alnum:]][[:alnum:].-]*(?:\\s*,\\s*[[:alnum:]][[:alnum:].-]*)*\\s+[—–-]\\s+"
      ),
      diagnosis_code = if_else(
        has_code_separator,
        str_extract(
          diagnosis_item,
          "^[[:alnum:]][[:alnum:].-]*(?:\\s*,\\s*[[:alnum:]][[:alnum:].-]*)*"
        ),
        NA_character_
      ),
      # All tables and alert cards use a clinical name only. The helper also
      # removes repeated legacy prefixes such as "CA40 — CA40 — ...".
      diagnosis_label = diagnosis_name_for_display(diagnosis_item),
      diagnosis_code = if_else(
        is.na(diagnosis_code),
        NA_character_,
        str_to_upper(str_squish(diagnosis_code))
      ),
      diagnosis_label = str_squish(diagnosis_label),
      diagnosis_key = diagnosis_label %>%
        str_to_lower() %>%
        str_replace_all("[^[:alnum:]]+", " ") %>%
        str_squish(),
      is_phe = is_phe_diagnosis(diagnosis_label)
    ) %>%
    filter(
      diagnosis_item != "",
      diagnosis_key != "",
      !str_detect(str_to_lower(diagnosis_item), "^page\\s+[0-9]+"),
      !str_detect(str_to_upper(diagnosis_item), "INVESTIGATION|MANAGEMENT")
    ) %>%
    distinct(visit_id, diagnosis_key, .keep_all = TRUE)
  
  diagnosis_rows %>%
    select(
      visit_id,
      visit_date,
      facility_group,
      state,
      county,
      diagnosis_code,
      diagnosis_label,
      diagnosis_key,
      is_phe
    )
}


# Creates one stable alert record for each qualifying diagnosis on each visit.
make_phe_alert_rows <- function(data) {
  empty_output <- tibble(
    alert_key = character(),
    visit_id = numeric(),
    alert_date = as.Date(character()),
    facility_group = character(),
    state = character(),
    county = character(),
    diagnosis_code = character(),
    diagnosis_label = character(),
    diagnosis_key = character()
  )
  
  if (nrow(data) == 0 || !"final_diagnosis" %in% names(data)) {
    return(empty_output)
  }
  
  # Speed optimization: avoid splitting every diagnosis string when no
  # notifiable/PHE keyword is present. This keeps the banner and alert workflow
  # accurate while making date changes and page loads faster.
  candidate_data <- data %>%
    filter(is_phe_diagnosis(final_diagnosis))
  
  if (nrow(candidate_data) == 0) {
    return(empty_output)
  }
  
  make_diagnosis_long(candidate_data) %>%
    filter(is_phe) %>%
    mutate(
      alert_key = paste0(
        as.character(visit_id), "::", diagnosis_key
      )
    ) %>%
    select(
      alert_key,
      visit_id,
      alert_date = visit_date,
      facility_group,
      state,
      county,
      diagnosis_code,
      diagnosis_label,
      diagnosis_key
    ) %>%
    distinct(alert_key, .keep_all = TRUE)
}

# Creates the persistent alert register and audit-history table. The register
# stores the latest workflow status; the history table records every change.
ensure_phe_alert_tables <- function() {
  con <- connect_db()
  on.exit(DBI::dbDisconnect(con), add = TRUE)
  
  DBI::dbExecute(
    con,
    "
    CREATE TABLE IF NOT EXISTS dcc_phe_alert_workflow (
      alert_key TEXT PRIMARY KEY,
      visit_id BIGINT NOT NULL,
      alert_date DATE,
      facility_group TEXT,
      state TEXT,
      county TEXT,
      diagnosis_code TEXT,
      diagnosis_label TEXT NOT NULL,
      diagnosis_key TEXT NOT NULL,
      status TEXT NOT NULL DEFAULT 'open',
      assigned_to TEXT,
      follow_up_note TEXT,
      updated_by TEXT,
      created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
      updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
      cleared_at TIMESTAMPTZ,
      CONSTRAINT dcc_phe_alert_workflow_status_check
        CHECK (status IN ('open', 'follow_up', 'cleared', 'discarded'))
    )
    "
  )
  
  # Update an existing installation created by an earlier dashboard version.
  # This keeps historical records and adds the non-destructive discarded status.
  DBI::dbExecute(
    con,
    "ALTER TABLE dcc_phe_alert_workflow
     DROP CONSTRAINT IF EXISTS dcc_phe_alert_workflow_status_check"
  )
  
  DBI::dbExecute(
    con,
    "ALTER TABLE dcc_phe_alert_workflow
     ADD CONSTRAINT dcc_phe_alert_workflow_status_check
     CHECK (status IN ('open', 'follow_up', 'cleared', 'discarded'))"
  )
  
  DBI::dbExecute(
    con,
    "
    CREATE TABLE IF NOT EXISTS dcc_phe_alert_history (
      change_id BIGSERIAL PRIMARY KEY,
      alert_key TEXT NOT NULL,
      old_status TEXT,
      new_status TEXT NOT NULL,
      note TEXT,
      assigned_to TEXT,
      changed_by TEXT NOT NULL,
      changed_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
      CONSTRAINT dcc_phe_alert_history_alert_fk
        FOREIGN KEY (alert_key)
        REFERENCES dcc_phe_alert_workflow(alert_key)
        ON DELETE RESTRICT
    )
    "
  )
  
  invisible(TRUE)
}

# Inserts newly detected PHE signals without overwriting an existing workflow
# status, follow-up note, assignee, or clearance decision.
sync_phe_alert_records <- function(data) {
  alerts <- make_phe_alert_rows(data)
  
  if (nrow(alerts) == 0) {
    return(invisible(0L))
  }
  
  con <- connect_db()
  on.exit(DBI::dbDisconnect(con), add = TRUE)
  
  sql <- "
    INSERT INTO dcc_phe_alert_workflow (
      alert_key, visit_id, alert_date, facility_group, state, county,
      diagnosis_code, diagnosis_label, diagnosis_key
    ) VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)
    ON CONFLICT (alert_key) DO UPDATE SET
      visit_id = EXCLUDED.visit_id,
      alert_date = EXCLUDED.alert_date,
      facility_group = EXCLUDED.facility_group,
      state = EXCLUDED.state,
      county = EXCLUDED.county,
      diagnosis_code = EXCLUDED.diagnosis_code,
      diagnosis_label = EXCLUDED.diagnosis_label,
      diagnosis_key = EXCLUDED.diagnosis_key
  "
  
  DBI::dbWithTransaction(con, {
    for (i in seq_len(nrow(alerts))) {
      row <- alerts[i, ]
      DBI::dbExecute(
        con,
        sql,
        params = list(
          as.character(row$alert_key),
          as.numeric(row$visit_id),
          as.Date(row$alert_date),
          as.character(row$facility_group),
          as.character(row$state),
          as.character(row$county),
          if (is.na(row$diagnosis_code)) NA_character_ else as.character(row$diagnosis_code),
          as.character(row$diagnosis_label),
          as.character(row$diagnosis_key)
        )
      )
    }
  })
  
  invisible(nrow(alerts))
}

fetch_phe_alert_workflow <- function() {
  con <- connect_db()
  on.exit(DBI::dbDisconnect(con), add = TRUE)
  
  data <- DBI::dbGetQuery(
    con,
    "
    SELECT
      alert_key,
      visit_id,
      alert_date,
      facility_group,
      state,
      county,
      diagnosis_code,
      diagnosis_label,
      diagnosis_key,
      status,
      assigned_to,
      follow_up_note,
      updated_by,
      created_at,
      updated_at,
      cleared_at
    FROM dcc_phe_alert_workflow
    ORDER BY
      CASE status
        WHEN 'open' THEN 1
        WHEN 'follow_up' THEN 2
        WHEN 'cleared' THEN 3
        WHEN 'discarded' THEN 4
        ELSE 5
      END,
      alert_date DESC,
      diagnosis_label
    "
  )
  
  if (nrow(data) == 0) {
    return(tibble(
      alert_key = character(),
      visit_id = numeric(),
      alert_date = as.Date(character()),
      facility_group = character(),
      state = character(),
      county = character(),
      diagnosis_code = character(),
      diagnosis_label = character(),
      diagnosis_key = character(),
      status = character(),
      assigned_to = character(),
      follow_up_note = character(),
      updated_by = character(),
      created_at = as.POSIXct(character()),
      updated_at = as.POSIXct(character()),
      cleared_at = as.POSIXct(character())
    ))
  }
  
  data %>%
    mutate(
      alert_date = as.Date(alert_date),
      status = if_else(
        status %in% c("open", "follow_up", "cleared", "discarded"),
        status,
        "open"
      )
    )
}

fetch_phe_alert_history <- function(alert_key) {
  con <- connect_db()
  on.exit(DBI::dbDisconnect(con), add = TRUE)
  
  DBI::dbGetQuery(
    con,
    "
    SELECT
      change_id,
      alert_key,
      old_status,
      new_status,
      note,
      assigned_to,
      changed_by,
      changed_at
    FROM dcc_phe_alert_history
    WHERE alert_key = $1
    ORDER BY changed_at DESC, change_id DESC
    ",
