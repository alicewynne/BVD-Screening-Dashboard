          function setMobileSidebar(open) {
            document.body.classList.toggle('mobile-sidebar-open', open);
            var button = document.getElementById('mobile_sidebar_toggle');
            if (button) button.setAttribute('aria-expanded', open ? 'true' : 'false');
            resizeDccPlots();
          }

          $(document).on('click', '#mobile_sidebar_toggle', function(event) {
            event.preventDefault();
            setMobileSidebar(!document.body.classList.contains('mobile-sidebar-open'));
          });

          $(document).on('click', '#mobile_sidebar_overlay', function() {
            setMobileSidebar(false);
          });

          $(document).on('click', '.sidebar-menu a', function() {
            if (window.innerWidth <= 991) setMobileSidebar(false);
          });

          $(document).on('shown.bs.tab', 'a[data-toggle=tab]', resizeDccPlots);
          $(document).on('shiny:value', resizeDccPlots);
          $(window).on('resize orientationchange', function() {
            if (window.innerWidth > 991) setMobileSidebar(false);
            resizeDccPlots();
          });

          $(document).on('keydown', function(event) {
            if (event.key === 'Escape') setMobileSidebar(false);
          });

          $(function() {
            resizeDccPlots();
          });
        })();
