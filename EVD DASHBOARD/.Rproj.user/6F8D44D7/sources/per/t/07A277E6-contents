condition_match <- function(data, condition_key) {
  regex <- condition_regex_lookup[[condition_key]]
  if (is.null(regex)) return(rep(FALSE, nrow(data)))
  str_detect(combined_diagnosis_text(data), regex)
}

suspected_condition_match <- function(data, condition_key) {
  regex <- condition_regex_lookup[[condition_key]]
  if (is.null(regex)) return(rep(FALSE, nrow(data)))
  str_detect(combined_working_diagnosis_text(data), regex)
}

investigation_ordered_match <- function(data, test_regex) {
  str_detect(combined_investigation_text(data), test_regex)
}

positive_result_match <- function(data, test_regex = "") {
  investigation_text <- combined_investigation_text(data)
  positive_text <- str_detect(investigation_text, "positive|detected|reactive|parasite|infection|pus cells|nitrite|leukocyte|bacteria")
  if (nzchar(test_regex)) {
    positive_text <- positive_text & str_detect(investigation_text, test_regex)
  }
  positive_text
}

