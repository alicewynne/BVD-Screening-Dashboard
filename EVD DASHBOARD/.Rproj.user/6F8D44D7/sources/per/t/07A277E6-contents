make_top_items_summary <- function(data, item_type = c("investigations", "medications"), top_n = 5) {
  item_type <- match.arg(item_type)
  
  if (nrow(data) == 0) {
    return(tibble(Rank = integer(), Item = character(), Count = integer()))
  }
  
  item_rows <- lapply(seq_len(nrow(data)), function(row_index) {
    items <- if (item_type == "investigations") {
      parse_investigation_items(data$ordered_investigation_codes_json[row_index])
    } else {
      # Count drugs actually administered. The prescription JSON includes
      # guideline headings and dose-limit notes such as "Max 2.4 G/Day",
      # which are not medicines and must never appear in this ranking.
      parse_medication_items(data$administered_drugs_json[row_index])
    }
    items <- unique(items[!is.na(items) & items != ""])
    if (length(items) == 0) return(NULL)
    tibble(visit_id = data$visit_id[row_index], Item = items)
  }) %>%
    bind_rows()
  
  if (nrow(item_rows) == 0) {
    return(tibble(Rank = integer(), Item = character(), Count = integer()))
  }
  
  item_rows %>%
    distinct(visit_id, Item) %>%
    count(Item, name = "Count", sort = TRUE) %>%
    slice_head(n = top_n) %>%
    mutate(Rank = row_number()) %>%
    select(Rank, Item, Count)
}

make_user_experience_summary <- function(data) {
  data <- data %>%
    mutate(
      patient_key = if_else(is.na(patient_key), paste0("visit_", visit_id), patient_key),
      dx_key = primary_definitive_diagnosis_key
    )
  
  diagnosis_users <- data %>%
    filter(!is.na(dx_key), dx_key != "") %>%
    distinct(patient_key, dx_key)
  
  repeat_users <- if (any(data$is_primary_dx_repeat_30d, na.rm = TRUE)) {
    data %>%
      filter(is_primary_dx_repeat_30d, !is.na(dx_key), dx_key != "") %>%
      distinct(patient_key, dx_key)
  } else {
    data %>%
      filter(!is.na(dx_key), dx_key != "") %>%
      arrange(patient_key, dx_key, visit_date) %>%
      group_by(patient_key, dx_key) %>%
      summarise(
        has_repeat_30d = any(as.numeric(diff(sort(unique(visit_date)))) <= 30, na.rm = TRUE),
        .groups = "drop"
      ) %>%
      filter(has_repeat_30d)
  }
  
  total_users <- data %>%
    filter(!is.na(patient_key), patient_key != "") %>%
    distinct(patient_key) %>%
    nrow()
  
  repeat_patient_keys <- repeat_users %>%
    ungroup() %>%
    pull(patient_key) %>%
    unique()
  
  return_users <- if (any(data$is_return_visit_new_reason, na.rm = TRUE)) {
    data %>% filter(is_return_visit_new_reason) %>% distinct(patient_key) %>% nrow()
  } else {
    data %>%
      group_by(patient_key) %>%
      summarise(total_visits = n_distinct(visit_id), .groups = "drop") %>%
      filter(total_visits > 1, !patient_key %in% repeat_patient_keys) %>%
      nrow()
  }
  
  bind_rows(
    clean_rate_row(
      metric = "Repeat Visit Rate",
      numerator = nrow(repeat_users),
      denominator = nrow(diagnosis_users),
      numerator_definition = "Users with the same definitive diagnosis on two or more visits within 30 days",
      denominator_definition = "Users with a definitive diagnosis",
      note = "Uses is_primary_dx_repeat_30d where available; otherwise derives from patient, diagnosis and visit date."
    ),
    clean_rate_row(
      metric = "Return Rate",
      numerator = return_users,
      denominator = total_users,
      numerator_definition = "Users with any subsequent visit excluding repeat visits where available",
      denominator_definition = "Total users",
      note = "Uses is_return_visit_new_reason where available; otherwise derives from patients with more than one visit."
    )
  )
}

