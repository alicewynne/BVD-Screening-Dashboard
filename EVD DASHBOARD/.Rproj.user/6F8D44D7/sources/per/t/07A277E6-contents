get_visit_data <- function() {
  con <- connect_db()
  on.exit(DBI::dbDisconnect(con), add = TRUE)
  
  available_fields <- names(
    DBI::dbGetQuery(
      con,
      "SELECT * FROM v_dcc_visits LIMIT 0"
    )
  )
  
  optional_select_expr <- function(field_name, alias_name = field_name) {
    matched_field <- available_fields[
      trimws(available_fields) == field_name
    ][1]
    
    alias_sql <- as.character(DBI::dbQuoteIdentifier(con, alias_name))
    
    if (length(matched_field) == 0 || is.na(matched_field)) {
      return(paste0("NULL::text AS ", alias_sql))
    }
    
    paste0(
      as.character(DBI::dbQuoteIdentifier(con, matched_field)),
      "::text AS ",
      alias_sql
    )
  }
  
  optional_presence_expr <- function(field_name, alias_name) {
    field_is_available <- field_name %in% trimws(available_fields)
    alias_sql <- as.character(DBI::dbQuoteIdentifier(con, alias_name))
    paste0(ifelse(field_is_available, "TRUE", "FALSE"), " AS ", alias_sql)
  }
  
  optional_first_select_expr <- function(field_names, alias_name) {
    matched_fields <- field_names[field_names %in% trimws(available_fields)]
    alias_sql <- as.character(DBI::dbQuoteIdentifier(con, alias_name))
    if (length(matched_fields) == 0) {
      return(paste0("NULL::text AS ", alias_sql))
    }
    paste0(
      as.character(DBI::dbQuoteIdentifier(con, matched_fields[1])),
      "::text AS ",
      alias_sql
    )
  }
  
  optional_any_presence_expr <- function(field_names, alias_name) {
    field_is_available <- any(field_names %in% trimws(available_fields))
    alias_sql <- as.character(DBI::dbQuoteIdentifier(con, alias_name))
    paste0(ifelse(field_is_available, "TRUE", "FALSE"), " AS ", alias_sql)
